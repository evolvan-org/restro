# ---------------------------------------------------------------------------
# Root environment template. Copy to `.env` and adjust as needed.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# ----- Docker Compose -----
# Picks which stack `docker compose up -d --build` runs (read by Compose itself):
#   docker-compose.yml       -> local      (api 3000, postgres 5433, web 3001)
#   docker-compose.prod.yml  -> production (api 8000, postgres 5434, web 3001)
# On the production server set COMPOSE_FILE=docker-compose.prod.yml.
COMPOSE_FILE=docker-compose.yml

# Production stack only (docker-compose.prod.yml): Postgres credentials.
# URL-encode the password if it contains characters like @ : / ? #
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=rms
# WEB_ORIGIN=http://localhost:3001
# Host ports for the production stack (defaults shown); change one if another
# app on the server already uses it.
# API_HOST_PORT=8000
# POSTGRES_HOST_PORT=5434
# WEB_HOST_PORT=3001
# Interface those ports bind to: 127.0.0.1 = reachable only via the reverse
# proxy on the server (default); 0.0.0.0 = exposed on <server-ip>:<port>.
# HOST_BIND_IP=127.0.0.1

# Node environment
NODE_ENV=development

# ----- Database (Prisma / PostgreSQL) -----
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/rms?schema=public

# ----- API (NestJS) -----
API_PORT=3000
JWT_SECRET=jwt-secret
RATE_LIMIT_HASH_SECRET=replace-with-at-least-16-random-characters

# Brevo transactional email (real delivery is used in every environment)
EMAIL_PROVIDER_API_KEY=replace-with-brevo-api-key
EMAIL_FROM_ADDRESS=sabarjits@evolvan.com
EMAIL_FROM_NAME=Restaurant Management System
EMAIL_TEMPLATE_VERIFY_EMAIL_ID=1
EMAIL_TEMPLATE_RESET_PASSWORD_ID=2
EMAIL_TEMPLATE_STAFF_INVITE_ID=3
APP_PUBLIC_URL=http://localhost:3001
# Set true only when the API is directly behind one trusted reverse proxy.
TRUST_PROXY=false

# Pusher Channels (server only; copy credentials from your Pusher app)
PUSHER_APP_ID=your-app-id
PUSHER_KEY=your-app-key
PUSHER_SECRET=your-app-secret
PUSHER_CLUSTER=ap2

# ----- AI assistance: menu / invoice scan, recipe drafts (REST-89) -----
# AI_PROVIDER: `fake` = canned demo results, no key needed (the default outside production).
#              `gemini` = real photo reading; needs GEMINI_API_KEY (the default in production).
AI_PROVIDER=fake
# Server-side only, never exposed to the web app. Create one at https://aistudio.google.com/apikey
# (use a paid-tier key in production so uploaded photos aren't used for training).
# Left empty with AI_PROVIDER=gemini: AI features show "unavailable" and fall back to CSV/manual.
GEMINI_API_KEY=
# Model IDs (check current Gemini model names and pricing before changing).
# AI_MODEL_MENU=gemini-3.5-flash-lite
# AI_MODEL_INVOICE=gemini-3.8-flash
# AI_MODEL_RECIPES=gemini-3.5-flash-lite
# Used for a minute whenever the model above is overloaded (503 "high demand" or cut streams).
# AI_MODEL_MENU_FALLBACK=gemini-3.1-flash-lite
# AI_MODEL_INVOICE_FALLBACK=gemini-3.5-flash
# AI_MODEL_RECIPES_FALLBACK=gemini-3.1-flash-lite
# Scan photos are kept on the API server's disk only until the scan is used or abandoned.
# AI_UPLOAD_DIR=./data/ai-uploads
# AI_IMAGE_TTL_HOURS=72
# AI_DAILY_MENU_SCANS=10
# AI_DAILY_INVOICE_SCANS=20
# AI_MAX_CONCURRENT_JOBS=3
# AI_PRICE_JUMP_PERCENT=15
# Fake provider only: ok | unreadable | partial | unavailable
#   flaky = every other stream drops halfway (to see interrupted scans resume)
# AI_FAKE_SCENARIO=ok
# Web Push for QR ordering alerts (REST-88). Optional: leave all three unset to disable push;
# in-app alerts still work. Generate keys with `npx web-push generate-vapid-keys`.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.com

# ----- Web (Next.js) -----
WEB_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3000
