# ---------------------------------------------------------------------------
# Root environment template. Copy to `.env` and adjust as needed.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Node environment
NODE_ENV=development

# ----- Database (Prisma / PostgreSQL) -----
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/rms?schema=public

# ----- API (NestJS) -----
API_PORT=3000
JWT_SECRET=jwt-secret

# Pusher Channels (server only; copy credentials from your Pusher app)
PUSHER_APP_ID=your-app-id
PUSHER_KEY=your-app-key
PUSHER_SECRET=your-app-secret
PUSHER_CLUSTER=ap2

# ----- Web (Next.js) -----
WEB_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3000
