# API-local environment template. The root `.env` is the primary source of
# truth in dev; copy this only if you run the API in isolation.
API_PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/rms?schema=public
NEXT_PUBLIC_API_URL=http://localhost:3000
JWT_SECRET=jwt-secret
RATE_LIMIT_HASH_SECRET=replace-with-at-least-16-random-characters
EMAIL_PROVIDER_API_KEY=replace-with-brevo-api-key
EMAIL_FROM_ADDRESS=sabarjits@evolvan.com
EMAIL_FROM_NAME=Restaurant Management System
EMAIL_TEMPLATE_VERIFY_EMAIL_ID=1
EMAIL_TEMPLATE_RESET_PASSWORD_ID=2
EMAIL_TEMPLATE_STAFF_INVITE_ID=3
APP_PUBLIC_URL=http://localhost:3001
TRUST_PROXY=false
PUSHER_APP_ID=your-app-id
PUSHER_KEY=your-app-key
PUSHER_SECRET=your-app-secret
PUSHER_CLUSTER=ap2
WEB_ORIGIN=http://localhost:3001
