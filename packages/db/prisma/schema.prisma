// Restaurant Management System — Prisma schema
// -----------------------------------------------------------------------------
// Conventions:
//   * PostgreSQL UUID primary keys (`@default(uuid())`).
//   * All timestamps are `timestamptz` (@db.Timestamptz) stored in UTC.
//   * DB identifiers are snake_case (@map / @@map); Prisma fields are camelCase.
//   * Every table is tenant-scoped via `restaurant_id`.
//
// Review fixes applied (critical + high):
//   [C1] orders.table_id added (dine-in anchor); orders.reservation_id nullable
//        so walk-ins don't need a fake reservation.
//   [C2] All datetime columns use @db.Timestamptz (true timezone-aware storage).
//   [C3] Enum values enforced via native Postgres enums (see `enum` blocks).
//   [H4] Indexes on every foreign key + common tenant/status filters.
//   [H5] Per-tenant uniqueness (email, bill_number, table_number, kot_number,
//        role name, table status code) instead of global uniqueness.
//   [H6] "One completed payment per bill" — Prisma cannot express a partial
//        unique index. Add this in a follow-up raw migration:
//          CREATE UNIQUE INDEX payments_one_completed_per_bill
//            ON payments (bill_id) WHERE status = 'COMPLETED';
//
// RBAC (agreed): `permissions` and `user_roles` tables dropped. Permission keys
// are the source of truth in @rms/permissions; roles are per-restaurant and
// seeded on signup; each user has exactly one role.
// -----------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enums (replace the varchar+comment "enums" from the original schema)
// ----------------------------------------------------------------------------

enum RestaurantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

/// Food vs bar — drives menu classification and Kitchen/Bar routing.
enum ServingType {
  FOOD
  BAR
}

enum ReservationStatus {
  BOOKED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum OrderStatus {
  OPEN
  SUBMITTED
  COMPLETED
  CANCELLED
}

enum OrderItemStatus {
  ACTIVE
  CANCELLED
}

enum KotDestination {
  KITCHEN
  BAR
}

/// Shared by kots and kot_items (identical lifecycle).
enum KotStatus {
  PENDING
  PREPARING
  READY
  COMPLETED
}

enum BillStatus {
  OPEN
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

// ----------------------------------------------------------------------------
// Tenant
// ----------------------------------------------------------------------------

model Restaurant {
  id             String           @id @default(uuid()) @db.Uuid
  name           String           @db.VarChar(255)
  gstNumber      String?          @map("gst_number") @db.VarChar(50)
  defaultGstRate Decimal          @default(0) @map("default_gst_rate") @db.Decimal(5, 2)
  currency       String           @default("INR") @db.VarChar(10)
  timezone       String           @default("Asia/Kolkata") @db.VarChar(100)
  status         RestaurantStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  users          User[]
  roles          Role[]
  diningSections DiningSection[]
  tableStatuses  TableStatus[]
  tables         RestaurantTable[]
  guests         Guest[]
  reservations   Reservation[]
  menuCategories MenuCategory[]
  menuItems      MenuItem[]
  orders         Order[]
  kots           Kot[]
  bills          Bill[]

  @@map("restaurants")
}

// ----------------------------------------------------------------------------
// Identity & Access
// ----------------------------------------------------------------------------

model User {
  id           String     @id @default(uuid()) @db.Uuid
  restaurantId String     @map("restaurant_id") @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  name         String     @db.VarChar(255)
  email        String     @db.VarChar(255)
  phone        String?    @db.VarChar(30)
  /// Authentication-only; never expose through the API.
  passwordHash String     @map("password_hash") @db.VarChar(255)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  role       Role       @relation(fields: [roleId], references: [id]) // Restrict (default): can't delete a role in use

  reservationsCreated Reservation[] @relation("ReservationCreatedBy")
  ordersCreated       Order[]       @relation("OrderCreatedBy")
  kotsCreated         Kot[]         @relation("KotCreatedBy")
  billsGenerated      Bill[]        @relation("BillGeneratedBy")
  paymentsRecorded    Payment[]     @relation("PaymentRecordedBy")

  @@unique([restaurantId, email]) // email unique per tenant, not globally
  @@index([restaurantId])
  @@index([roleId])
  @@map("users")
}

model Role {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  /// Seeded from @rms/permissions on signup: ADMIN, MANAGER, STAFF, CUSTOMER.
  name         String   @db.VarChar(100)
  description  String?  @db.VarChar(255)
  /// Seeded system roles — protect from delete/rename in app logic.
  isSystem     Boolean  @default(false) @map("is_system")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant  Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  users       User[]
  permissions RolePermission[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@map("roles")
}

model RolePermission {
  roleId        String   @map("role_id") @db.Uuid
  /// Validated against @rms/permissions at write time; code is the source of truth.
  permissionKey String   @map("permission_key") @db.VarChar(150)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

// ----------------------------------------------------------------------------
// Floor: sections, table statuses, tables
// ----------------------------------------------------------------------------

model DiningSection {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  name         String   @db.VarChar(150)
  description  String?  @db.VarChar(255)
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant        @relation(fields: [restaurantId], references: [id])
  tables     RestaurantTable[]

  @@index([restaurantId])
  @@map("dining_sections")
}

model TableStatus {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  code         String   @db.VarChar(50)
  name         String   @db.VarChar(100)
  sortOrder    Int      @default(0) @map("sort_order")
  /// System lifecycle statuses may be protected from deletion.
  isSystem     Boolean  @default(false) @map("is_system")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant        @relation(fields: [restaurantId], references: [id])
  tables     RestaurantTable[]

  @@unique([restaurantId, code])
  @@index([restaurantId])
  @@map("table_statuses")
}

model RestaurantTable {
  id              String   @id @default(uuid()) @db.Uuid
  restaurantId    String   @map("restaurant_id") @db.Uuid
  sectionId       String   @map("section_id") @db.Uuid
  currentStatusId String   @map("current_status_id") @db.Uuid
  tableNumber     String   @map("table_number") @db.VarChar(50)
  capacity        Int
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id])
  section       DiningSection @relation(fields: [sectionId], references: [id])
  currentStatus TableStatus   @relation(fields: [currentStatusId], references: [id])
  reservations  Reservation[]
  orders        Order[]

  @@unique([restaurantId, tableNumber])
  @@index([restaurantId])
  @@index([sectionId])
  @@index([currentStatusId])
  @@map("restaurant_tables")
}

// ----------------------------------------------------------------------------
// Guests & reservations
// ----------------------------------------------------------------------------

model Guest {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  guestName    String   @map("guest_name") @db.VarChar(255)
  phoneNumber  String   @map("phone_number") @db.VarChar(30)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id])
  reservations Reservation[]

  @@index([restaurantId])
  @@map("guests")
}

model Reservation {
  id              String            @id @default(uuid()) @db.Uuid
  restaurantId    String            @map("restaurant_id") @db.Uuid
  guestId         String            @map("guest_id") @db.Uuid
  tableId         String?           @map("table_id") @db.Uuid
  createdByUserId String            @map("created_by_user_id") @db.Uuid
  reservationAt   DateTime          @map("reservation_at") @db.Timestamptz(6)
  partySize       Int               @map("party_size")
  status          ReservationStatus @default(BOOKED)
  notes           String?           @db.VarChar(255)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant    Restaurant       @relation(fields: [restaurantId], references: [id])
  guest         Guest            @relation(fields: [guestId], references: [id])
  table         RestaurantTable? @relation(fields: [tableId], references: [id])
  createdByUser User             @relation("ReservationCreatedBy", fields: [createdByUserId], references: [id])
  orders        Order[]

  @@index([restaurantId])
  @@index([guestId])
  @@index([tableId])
  @@index([createdByUserId])
  @@map("reservations")
}

// ----------------------------------------------------------------------------
// Menu
// ----------------------------------------------------------------------------

model MenuCategory {
  id           String      @id @default(uuid()) @db.Uuid
  restaurantId String      @map("restaurant_id") @db.Uuid
  name         String      @db.VarChar(150)
  categoryType ServingType @map("category_type")
  sortOrder    Int         @default(0) @map("sort_order")
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  items      MenuItem[]

  @@index([restaurantId])
  @@map("menu_categories")
}

model MenuItem {
  id           String      @id @default(uuid()) @db.Uuid
  restaurantId String      @map("restaurant_id") @db.Uuid
  categoryId   String      @map("category_id") @db.Uuid
  name         String      @db.VarChar(255)
  description  String?     @db.VarChar(255)
  price        Decimal     @db.Decimal(12, 2)
  /// FOOD or BAR — used for Kitchen/Bar routing.
  itemType     ServingType @map("item_type")
  isAvailable  Boolean     @default(true) @map("is_available")
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id])
  category   MenuCategory @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]

  @@index([restaurantId])
  @@index([categoryId])
  @@map("menu_items")
}

// ----------------------------------------------------------------------------
// Orders
// ----------------------------------------------------------------------------

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  restaurantId    String      @map("restaurant_id") @db.Uuid
  tableId         String      @map("table_id") @db.Uuid // [C1] dine-in anchor
  reservationId   String?     @map("reservation_id") @db.Uuid // [C1] nullable: walk-ins have no reservation
  createdByUserId String      @map("created_by_user_id") @db.Uuid
  status          OrderStatus @default(OPEN)
  notes           String?     @db.VarChar(255)
  openedAt        DateTime    @map("opened_at") @db.Timestamptz(6)
  completedAt     DateTime?   @map("completed_at") @db.Timestamptz(6)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant    Restaurant      @relation(fields: [restaurantId], references: [id])
  table         RestaurantTable @relation(fields: [tableId], references: [id])
  reservation   Reservation?    @relation(fields: [reservationId], references: [id])
  createdByUser User            @relation("OrderCreatedBy", fields: [createdByUserId], references: [id])
  items         OrderItem[]
  kots          Kot[]
  bill          Bill?

  @@index([restaurantId])
  @@index([tableId])
  @@index([reservationId])
  @@index([createdByUserId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id                  String          @id @default(uuid()) @db.Uuid
  orderId             String          @map("order_id") @db.Uuid
  menuItemId          String          @map("menu_item_id") @db.Uuid
  quantity            Int
  /// Price snapshot at time of ordering — insulates the bill from later menu edits.
  unitPrice           Decimal         @map("unit_price") @db.Decimal(12, 2)
  specialInstructions String?         @map("special_instructions") @db.VarChar(255)
  status              OrderItemStatus @default(ACTIVE)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem  @relation(fields: [menuItemId], references: [id])
  kotItems KotItem[]

  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}

// ----------------------------------------------------------------------------
// Kitchen Order Tickets (KOT)
// ----------------------------------------------------------------------------

model Kot {
  id              String         @id @default(uuid()) @db.Uuid
  restaurantId    String         @map("restaurant_id") @db.Uuid
  orderId         String         @map("order_id") @db.Uuid
  createdByUserId String         @map("created_by_user_id") @db.Uuid
  kotNumber       String         @map("kot_number") @db.VarChar(50)
  destination     KotDestination
  status          KotStatus      @default(PENDING)
  completedAt     DateTime?      @map("completed_at") @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant    Restaurant @relation(fields: [restaurantId], references: [id])
  order         Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdByUser User       @relation("KotCreatedBy", fields: [createdByUserId], references: [id])
  items         KotItem[]

  @@unique([restaurantId, kotNumber])
  @@index([restaurantId])
  @@index([orderId])
  @@index([createdByUserId])
  @@map("kots")
}

model KotItem {
  id          String    @id @default(uuid()) @db.Uuid
  kotId       String    @map("kot_id") @db.Uuid
  orderItemId String    @map("order_item_id") @db.Uuid
  quantity    Int
  status      KotStatus @default(PENDING)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  kot       Kot       @relation(fields: [kotId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@index([kotId])
  @@index([orderItemId])
  @@map("kot_items")
}

// ----------------------------------------------------------------------------
// Billing & payments
// ----------------------------------------------------------------------------

model Bill {
  id                String     @id @default(uuid()) @db.Uuid
  restaurantId      String     @map("restaurant_id") @db.Uuid
  /// MVP: one bill per order (split bills excluded).
  orderId           String     @unique @map("order_id") @db.Uuid
  generatedByUserId String     @map("generated_by_user_id") @db.Uuid
  billNumber        String     @map("bill_number") @db.VarChar(50)
  subtotal          Decimal    @default(0) @db.Decimal(12, 2)
  discountAmount    Decimal    @default(0) @map("discount_amount") @db.Decimal(12, 2)
  gstRate           Decimal    @default(0) @map("gst_rate") @db.Decimal(5, 2)
  gstAmount         Decimal    @default(0) @map("gst_amount") @db.Decimal(12, 2)
  totalAmount       Decimal    @default(0) @map("total_amount") @db.Decimal(12, 2)
  status            BillStatus @default(OPEN)
  generatedAt       DateTime   @map("generated_at") @db.Timestamptz(6)
  paidAt            DateTime?  @map("paid_at") @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant      Restaurant @relation(fields: [restaurantId], references: [id])
  order           Order      @relation(fields: [orderId], references: [id])
  generatedByUser User       @relation("BillGeneratedBy", fields: [generatedByUserId], references: [id])
  payments        Payment[]

  @@unique([restaurantId, billNumber]) // bill number unique per tenant
  @@index([restaurantId])
  @@index([generatedByUserId])
  @@index([status])
  @@map("bills")
}

model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  billId           String        @map("bill_id") @db.Uuid
  recordedByUserId String        @map("recorded_by_user_id") @db.Uuid
  paymentMethod    PaymentMethod @map("payment_method")
  amount           Decimal       @db.Decimal(12, 2)
  /// MVP permits one COMPLETED settlement per bill (enforced by a partial
  /// unique index added via raw migration — see [H6] header note). Retries may
  /// create additional PENDING/FAILED records.
  status           PaymentStatus @default(COMPLETED)
  referenceNumber  String?       @map("reference_number") @db.VarChar(255)
  paidAt           DateTime?     @map("paid_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  // Append-only: no updated_at by design.

  bill           Bill @relation(fields: [billId], references: [id], onDelete: Cascade)
  recordedByUser User @relation("PaymentRecordedBy", fields: [recordedByUserId], references: [id])

  @@index([billId])
  @@index([recordedByUserId])
  @@map("payments")
}
