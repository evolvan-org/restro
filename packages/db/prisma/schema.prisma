// Restaurant Management System — Prisma schema
// -----------------------------------------------------------------------------
// Conventions:
//   * PostgreSQL UUID primary keys (`@default(uuid())`).
//   * All timestamps are `timestamptz` (@db.Timestamptz) stored in UTC.
//   * DB identifiers are snake_case (@map / @@map); Prisma fields are camelCase.
//   * Every table is tenant-scoped via `restaurant_id`.
//
// Review fixes applied (critical + high):
//   [C1] orders.table_id added (dine-in anchor); orders.reservation_id nullable
//        so walk-ins don't need a fake reservation.
//   [C2] All datetime columns use @db.Timestamptz (true timezone-aware storage).
//   [C3] Enum values enforced via native Postgres enums (see `enum` blocks).
//   [H4] Indexes on every foreign key + common tenant/status filters.
//   [H5] Per-tenant uniqueness (email, bill_number, table_number, kot_number,
//        role name, table status code) instead of global uniqueness.
//   [H6] "One completed payment per bill" — Prisma cannot express a partial
//        unique index. Add this in a follow-up raw migration:
//          CREATE UNIQUE INDEX payments_one_completed_per_bill
//            ON payments (bill_id) WHERE status = 'COMPLETED';
//
// RBAC (agreed): `permissions` and `user_roles` tables dropped. Permission keys
// are the source of truth in @rms/permissions; roles are per-restaurant and
// seeded on signup; each user has exactly one role.
// -----------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enums (replace the varchar+comment "enums" from the original schema)
// ----------------------------------------------------------------------------

enum RestaurantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum RoleAuditAction {
  CREATED
  UPDATED
  RESET
  DELETED
}

enum UserStatus {
  INVITED
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum UserTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  STAFF_INVITE
}

enum AuthRateLimitAction {
  RESEND_VERIFICATION_MINUTE
  RESEND_VERIFICATION_HOUR
  FORGOT_PASSWORD_EMAIL
  FORGOT_PASSWORD_IP
  RESEND_STAFF_INVITE_MINUTE
  RESEND_STAFF_INVITE_HOUR
  STAFF_PASSWORD_RESET_HOUR
}

enum NotificationType {
  KOT_SENT            @map("kot.sent")
  KOT_READY           @map("kot.ready")
  RESERVATION_CREATED @map("reservation.created")
}

enum NotificationEntity {
  ORDER       @map("order")
  RESERVATION @map("reservation")
}

/// Food vs bar — drives menu classification and Kitchen/Bar routing.
enum ServingType {
  FOOD
  BAR
}

enum ReservationStatus {
  BOOKED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum OrderStatus {
  OPEN
  SUBMITTED
  COMPLETED
  CANCELLED
}

enum OrderItemStatus {
  ACTIVE
  CANCELLED
}

enum KotDestination {
  KITCHEN
  BAR
}

/// Shared by kots and kot_items (identical lifecycle).
enum KotStatus {
  PENDING
  PREPARING
  READY
  COMPLETED
}

enum BillStatus {
  OPEN
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

// ----------------------------------------------------------------------------
// Tenant
// ----------------------------------------------------------------------------

model Restaurant {
  id                    String           @id @default(uuid()) @db.Uuid
  name                  String           @db.VarChar(255)
  gstNumber             String?          @map("gst_number") @db.VarChar(50)
  defaultGstRate        Decimal          @default(0) @map("default_gst_rate") @db.Decimal(5, 2)
  maxDiscountPercent    Decimal          @default(20) @map("max_discount_percent") @db.Decimal(5, 2)
  address               String?          @db.VarChar(500)
  currency              String           @default("INR") @db.VarChar(10)
  timezone              String           @default("Asia/Kolkata") @db.VarChar(100)
  status                RestaurantStatus @default(ACTIVE)
  /// Null while the owner's guided setup is pending; set once by `POST /onboarding/complete`.
  onboardingCompletedAt DateTime?        @map("onboarding_completed_at") @db.Timestamptz(6)
  /// Target food-cost band (percent of selling price); drives healthy / watch / poor margins.
  targetFoodCostMin     Decimal          @default(30) @map("target_food_cost_min") @db.Decimal(5, 2)
  targetFoodCostMax     Decimal          @default(35) @map("target_food_cost_max") @db.Decimal(5, 2)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  users                   User[]
  userTokens              UserToken[]
  roles                   Role[]
  roleAuditLogs           RoleAuditLog[]
  diningSections          DiningSection[]
  tableStatuses           TableStatus[]
  tables                  RestaurantTable[]
  guests                  Guest[]
  reservations            Reservation[]
  menuCategories          MenuCategory[]
  menuItems               MenuItem[]
  menuItemVariants        MenuItemVariant[]
  aiJobs                  AiJob[]
  aiUsage                 AiUsage[]
  stockItems              StockItem[]
  stockBatches            StockBatch[]
  stockMovements          StockMovement[]
  inventorySuppliers      InventorySupplier[]
  inventoryPurchaseOrders InventoryPurchaseOrder[]
  inventoryReceipts       InventoryReceipt[]
  orders                  Order[]
  kots                    Kot[]
  bills                   Bill[]
  notifications           Notification[]
  billCancellationReasons BillCancellationReason[]
  onboardingDraft         OnboardingDraft?

  @@map("restaurants")
}

/// The owner's in-progress setup. Nothing in it touches business tables until onboarding completes,
/// at which point the row is deleted. `version` guards against two tabs overwriting each other.
model OnboardingDraft {
  restaurantId String   @id @map("restaurant_id") @db.Uuid
  currentStep  Int      @default(0) @map("current_step")
  skippedSteps Int[]    @default([]) @map("skipped_steps")
  data         Json     @default("{}")
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("onboarding_drafts")
}

// ----------------------------------------------------------------------------
// Identity & Access
// ----------------------------------------------------------------------------

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  restaurantId       String     @map("restaurant_id") @db.Uuid
  roleId             String     @map("role_id") @db.Uuid
  name               String     @db.VarChar(255)
  email              String     @unique @db.VarChar(255) // globally unique across all tenants
  phone              String?    @db.VarChar(30)
  /// Authentication-only; never expose through the API.
  passwordHash       String?    @map("password_hash") @db.VarChar(255)
  status             UserStatus @default(ACTIVE)
  emailVerifiedAt    DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  authVersion        Int        @default(0) @map("auth_version")
  /// Set for accounts created with a generated one-time password; cleared on the first password change.
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id])
  role       Role        @relation(fields: [roleId], references: [id]) // Restrict (default): can't delete a role in use
  tokens     UserToken[]

  reservationsCaptained   Reservation[]            @relation("ReservationCaptain")
  reservationsCreated     Reservation[]            @relation("ReservationCreatedBy")
  tablesCaptained         RestaurantTable[]        @relation("TableCaptain")
  ordersCreated           Order[]                  @relation("OrderCreatedBy")
  kotsCreated             Kot[]                    @relation("KotCreatedBy")
  billsGenerated          Bill[]                   @relation("BillGeneratedBy")
  paymentsRecorded        Payment[]                @relation("PaymentRecordedBy")
  notifications           Notification[]
  stockMovements          StockMovement[]
  inventoryPurchaseOrders InventoryPurchaseOrder[]
  inventoryReceipts       InventoryReceipt[]
  roleAuditLogs           RoleAuditLog[]

  @@index([restaurantId])
  @@index([roleId])
  @@map("users")
}

model UserToken {
  id           String        @id @default(uuid()) @db.Uuid
  restaurantId String        @map("restaurant_id") @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  type         UserTokenType
  tokenHash    String        @unique @map("token_hash") @db.VarChar(64)
  expiresAt    DateTime      @map("expires_at") @db.Timestamptz(6)
  usedAt       DateTime?     @map("used_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([userId])
  @@index([userId, type, createdAt])
  @@index([expiresAt])
  @@map("user_tokens")
}

/// Pre-authentication abuse controls cannot always be tenant scoped. Subject keys are HMAC hashes;
/// raw email addresses and IP addresses are never persisted.
model AuthRateLimitCounter {
  id          String              @id @default(uuid()) @db.Uuid
  action      AuthRateLimitAction
  subjectHash String              @map("subject_hash") @db.VarChar(64)
  windowStart DateTime            @map("window_start") @db.Timestamptz(6)
  count       Int                 @default(1)
  expiresAt   DateTime            @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([action, subjectHash, windowStart])
  @@index([expiresAt])
  @@map("auth_rate_limit_counters")
}

model Notification {
  id              String             @id @default(uuid()) @db.Uuid
  restaurantId    String             @map("restaurant_id") @db.Uuid
  recipientUserId String             @map("recipient_user_id") @db.Uuid
  type            NotificationType
  title           String             @db.VarChar(255)
  body            String
  entity          NotificationEntity
  entityId        String             @map("entity_id") @db.Uuid
  tableId         String?            @map("table_id") @db.Uuid
  readAt          DateTime?          @map("read_at") @db.Timestamptz(6)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  recipient  User       @relation(fields: [recipientUserId], references: [id])

  @@index([restaurantId, recipientUserId, createdAt, id])
  @@index([restaurantId, recipientUserId, readAt])
  @@map("notifications")
}

model Role {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  /// Seeded from @rms/permissions on signup: OWNER, MANAGER, CAPTAIN, RECEPTION, KITCHEN_STAFF,
  /// BAR_STAFF. Custom roles are free-form names, unique per restaurant.
  name         String   @db.VarChar(100)
  description  String?  @db.VarChar(255)
  /// Seeded system roles — protect from delete/rename in app logic.
  isSystem     Boolean  @default(false) @map("is_system")
  /// Account Owner bypass role: passes every permission check and carries no role_permissions rows.
  /// At most one per restaurant (partial unique index in a raw migration).
  isOwner      Boolean  @default(false) @map("is_owner")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant  Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  users       User[]
  permissions RolePermission[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@map("roles")
}

/// Who changed which role and which permission keys were added or removed.
model RoleAuditLog {
  id           String          @id @default(uuid()) @db.Uuid
  restaurantId String          @map("restaurant_id") @db.Uuid
  /// Not a relation: the entry must outlive the role it describes.
  roleId       String          @map("role_id") @db.Uuid
  roleName     String          @map("role_name") @db.VarChar(100)
  actorUserId  String?         @map("actor_user_id") @db.Uuid
  action       RoleAuditAction
  addedKeys    String[]        @map("added_keys")
  removedKeys  String[]        @map("removed_keys")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  actor      User?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@map("role_audit_logs")
}

model RolePermission {
  roleId        String   @map("role_id") @db.Uuid
  /// Validated against @rms/permissions at write time; code is the source of truth.
  permissionKey String   @map("permission_key") @db.VarChar(150)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

// ----------------------------------------------------------------------------
// Floor: sections, table statuses, tables
// ----------------------------------------------------------------------------

model DiningSection {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  name         String   @db.VarChar(150)
  description  String?  @db.VarChar(255)
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant        @relation(fields: [restaurantId], references: [id])
  tables     RestaurantTable[]

  @@index([restaurantId])
  @@map("dining_sections")
}

model TableStatus {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  code         String   @db.VarChar(50)
  name         String   @db.VarChar(100)
  sortOrder    Int      @default(0) @map("sort_order")
  /// System lifecycle statuses may be protected from deletion.
  isSystem     Boolean  @default(false) @map("is_system")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant        @relation(fields: [restaurantId], references: [id])
  tables     RestaurantTable[]

  @@unique([restaurantId, code])
  @@index([restaurantId])
  @@map("table_statuses")
}

model RestaurantTable {
  id              String   @id @default(uuid()) @db.Uuid
  restaurantId    String   @map("restaurant_id") @db.Uuid
  sectionId       String   @map("section_id") @db.Uuid
  currentStatusId String   @map("current_status_id") @db.Uuid
  captainUserId   String?  @map("captain_user_id") @db.Uuid
  tableNumber     String   @map("table_number") @db.VarChar(50)
  capacity        Int
  isActive        Boolean  @default(true) @map("is_active")
  /// UTC timestamp of the last status transition.
  statusChangedAt DateTime @default(now()) @map("status_changed_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id])
  section       DiningSection @relation(fields: [sectionId], references: [id])
  currentStatus TableStatus   @relation(fields: [currentStatusId], references: [id])
  captain       User?         @relation("TableCaptain", fields: [captainUserId], references: [id])
  reservations  Reservation[]
  orders        Order[]

  // Case-insensitive uniqueness per section is enforced by a raw index on
  // (restaurant_id, section_id, lower(table_number))
  // (20261125120000_tables_number_unique_per_section); Prisma can't express it.
  @@unique([restaurantId, sectionId, tableNumber])
  @@index([restaurantId])
  @@index([sectionId])
  @@index([currentStatusId])
  @@index([captainUserId])
  @@map("restaurant_tables")
}

// ----------------------------------------------------------------------------
// Guests & reservations
// ----------------------------------------------------------------------------

model Guest {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  guestName    String   @map("guest_name") @db.VarChar(255)
  phoneNumber  String   @map("phone_number") @db.VarChar(30)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id])
  reservations Reservation[]

  @@unique([restaurantId, phoneNumber])
  @@map("guests")
}

model Reservation {
  id                 String            @id @default(uuid()) @db.Uuid
  restaurantId       String            @map("restaurant_id") @db.Uuid
  guestId            String            @map("guest_id") @db.Uuid
  tableId            String?           @map("table_id") @db.Uuid
  captainUserId      String?           @map("captain_user_id") @db.Uuid
  createdByUserId    String            @map("created_by_user_id") @db.Uuid
  reservationAt      DateTime          @map("reservation_at") @db.Timestamptz(6)
  partySize          Int               @map("party_size")
  status             ReservationStatus @default(BOOKED)
  notes              String?           @db.VarChar(255)
  cancellationReason String?           @map("cancellation_reason") @db.VarChar(255)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant    Restaurant       @relation(fields: [restaurantId], references: [id])
  guest         Guest            @relation(fields: [guestId], references: [id])
  table         RestaurantTable? @relation(fields: [tableId], references: [id])
  captain       User?            @relation("ReservationCaptain", fields: [captainUserId], references: [id])
  createdByUser User             @relation("ReservationCreatedBy", fields: [createdByUserId], references: [id])
  orders        Order[]

  @@index([restaurantId])
  @@index([guestId])
  @@index([tableId])
  @@index([createdByUserId])
  @@index([captainUserId])
  @@map("reservations")
}

// ----------------------------------------------------------------------------
// Menu
// ----------------------------------------------------------------------------

model MenuCategory {
  id           String      @id @default(uuid()) @db.Uuid
  restaurantId String      @map("restaurant_id") @db.Uuid
  name         String      @db.VarChar(150)
  categoryType ServingType @map("category_type")
  sortOrder    Int         @default(0) @map("sort_order")
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  items      MenuItem[]

  @@index([restaurantId])
  @@map("menu_categories")
}

model MenuItem {
  id               String       @id @default(uuid()) @db.Uuid
  restaurantId     String       @map("restaurant_id") @db.Uuid
  categoryId       String       @map("category_id") @db.Uuid
  name             String       @db.VarChar(255)
  description      String?      @db.VarChar(255)
  price            Decimal      @db.Decimal(12, 2)
  /// FOOD or BAR — used for Kitchen/Bar routing.
  itemType         ServingType  @map("item_type")
  isAvailable      Boolean      @default(true) @map("is_available")
  isActive         Boolean      @default(true) @map("is_active")
  /// False marks "No recipe needed" (e.g. bottled drinks), which silences the missing-recipe prompt.
  recipeRequired   Boolean      @default(true) @map("recipe_required")
  /// Veg / non-veg / egg marker; null when the owner hasn't said.
  dietType         DietType?    @map("diet_type")
  /// AI_DRAFT recipes stay flagged until a person reviews them (`recipeReviewedAt`).
  recipeSource     RecipeSource @default(MANUAL) @map("recipe_source")
  recipeReviewedAt DateTime?    @map("recipe_reviewed_at") @db.Timestamptz(6)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant  Restaurant        @relation(fields: [restaurantId], references: [id])
  category    MenuCategory      @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  recipeItems RecipeItem[]
  variants    MenuItemVariant[]

  @@index([restaurantId])
  @@index([categoryId])
  @@map("menu_items")
}

enum DietType {
  VEG
  NON_VEG
  EGG
}

enum RecipeSource {
  MANUAL
  AI_DRAFT
}

/// Optional portion variants (Half / Full). An item without variants is ordered at `MenuItem.price`.
model MenuItemVariant {
  id            String   @id @default(uuid()) @db.Uuid
  restaurantId  String   @map("restaurant_id") @db.Uuid
  menuItemId    String   @map("menu_item_id") @db.Uuid
  name          String   @db.VarChar(50)
  price         Decimal  @db.Decimal(12, 2)
  /// Recipe quantity multiplier (Half = 0.5, Full = 1).
  portionFactor Decimal  @default(1) @map("portion_factor") @db.Decimal(5, 3)
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id])
  menuItem   MenuItem    @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([menuItemId, name])
  @@index([restaurantId])
  @@map("menu_item_variants")
}

/// Unit of measure for a recipe ingredient quantity.
enum Unit {
  G
  KG
  ML
  L
  UNIT
}

/// Restaurant ingredient master shared by recipes and inventory.
model StockItem {
  id                String             @id @default(uuid()) @db.Uuid
  restaurantId      String             @map("restaurant_id") @db.Uuid
  name              String             @db.VarChar(150)
  isActive          Boolean            @default(true) @map("is_active")
  sku               String?            @db.VarChar(60)
  baseUnit          InventoryBaseUnit? @map("base_unit")
  reorderLevel      Decimal            @default(0) @map("reorder_level") @db.Decimal(12, 3)
  currentStock      Decimal            @default(0) @map("current_stock") @db.Decimal(12, 3)
  averageUnitCost   Decimal?           @map("average_unit_cost") @db.Decimal(18, 8)
  /// Estimated cost per base unit, used for food cost until a real purchase cost exists.
  estimatedUnitCost Decimal?           @map("estimated_unit_cost") @db.Decimal(18, 8)
  openedAt          DateTime?          @map("opened_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant    Restaurant                   @relation(fields: [restaurantId], references: [id])
  recipeItems   RecipeItem[]
  batches       StockBatch[]
  movements     StockMovement[]
  purchaseLines InventoryPurchaseOrderLine[]
  receiptLines  InventoryReceiptLine[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@map("stock_items")
}

/// One ingredient line of a menu item's recipe. Links the dish to stock; no stock is consumed here.
model RecipeItem {
  id          String   @id @default(uuid()) @db.Uuid
  menuItemId  String   @map("menu_item_id") @db.Uuid
  stockItemId String   @map("stock_item_id") @db.Uuid
  quantity    Decimal  @db.Decimal(12, 3)
  unit        Unit
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  menuItem  MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  stockItem StockItem @relation(fields: [stockItemId], references: [id])

  @@unique([menuItemId, stockItemId])
  @@index([menuItemId])
  @@index([stockItemId])
  @@map("recipe_items")
}

// ----------------------------------------------------------------------------
// Core inventory
// ----------------------------------------------------------------------------

enum InventoryBaseUnit {
  G
  ML
  UNIT
}

enum StockMovementKind {
  OPENING
  ADJUSTMENT
  RECEIPT
  WASTE
}

enum InventoryPurchaseStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model StockBatch {
  id                String    @id @default(uuid()) @db.Uuid
  restaurantId      String    @map("restaurant_id") @db.Uuid
  stockItemId       String    @map("stock_item_id") @db.Uuid
  receiptLineId     String?   @unique @map("receipt_line_id") @db.Uuid
  batchNumber       String    @map("batch_number") @db.VarChar(80)
  quantityReceived  Decimal   @map("quantity_received") @db.Decimal(12, 3)
  quantityRemaining Decimal   @map("quantity_remaining") @db.Decimal(12, 3)
  unitCost          Decimal   @map("unit_cost") @db.Decimal(18, 8)
  expiryDate        DateTime? @map("expiry_date") @db.Date
  receivedAt        DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)

  restaurant  Restaurant            @relation(fields: [restaurantId], references: [id])
  stockItem   StockItem             @relation(fields: [stockItemId], references: [id])
  receiptLine InventoryReceiptLine? @relation(fields: [receiptLineId], references: [id])
  movements   StockMovement[]

  @@index([restaurantId, stockItemId, receivedAt])
  @@index([restaurantId, expiryDate])
  @@map("stock_batches")
}

model StockMovement {
  id           String            @id @default(uuid()) @db.Uuid
  restaurantId String            @map("restaurant_id") @db.Uuid
  stockItemId  String            @map("stock_item_id") @db.Uuid
  batchId      String?           @map("batch_id") @db.Uuid
  receiptId    String?           @map("receipt_id") @db.Uuid
  actorId      String            @map("actor_id") @db.Uuid
  kind         StockMovementKind
  quantity     Decimal           @db.Decimal(12, 3)
  unitCost     Decimal?          @map("unit_cost") @db.Decimal(18, 8)
  reason       String            @db.VarChar(500)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  restaurant Restaurant        @relation(fields: [restaurantId], references: [id])
  stockItem  StockItem         @relation(fields: [stockItemId], references: [id])
  batch      StockBatch?       @relation(fields: [batchId], references: [id])
  receipt    InventoryReceipt? @relation(fields: [receiptId], references: [id])
  actor      User              @relation(fields: [actorId], references: [id])

  @@index([restaurantId, createdAt])
  @@index([restaurantId, stockItemId, createdAt])
  @@index([batchId])
  @@index([receiptId])
  @@map("stock_movements")
}

model InventorySupplier {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  name         String   @db.VarChar(150)
  contactName  String   @default("") @map("contact_name") @db.VarChar(150)
  email        String   @default("") @db.VarChar(255)
  phone        String   @default("") @db.VarChar(30)
  address      String   @default("") @db.VarChar(500)
  /// Supplier GSTIN; scanned invoices match suppliers by it.
  gstin        String?  @db.VarChar(15)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant               @relation(fields: [restaurantId], references: [id])
  purchases  InventoryPurchaseOrder[]
  receipts   InventoryReceipt[]

  @@unique([restaurantId, name])
  @@unique([restaurantId, gstin])
  @@index([restaurantId, isActive])
  @@map("inventory_suppliers")
}

model InventoryPurchaseOrder {
  id           String                  @id @default(uuid()) @db.Uuid
  restaurantId String                  @map("restaurant_id") @db.Uuid
  supplierId   String                  @map("supplier_id") @db.Uuid
  actorId      String                  @map("actor_id") @db.Uuid
  number       Int
  status       InventoryPurchaseStatus @default(DRAFT)
  expectedDate DateTime?               @map("expected_date") @db.Date
  notes        String                  @default("") @db.VarChar(500)
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant                   @relation(fields: [restaurantId], references: [id])
  supplier   InventorySupplier            @relation(fields: [supplierId], references: [id])
  actor      User                         @relation(fields: [actorId], references: [id])
  lines      InventoryPurchaseOrderLine[]
  receipts   InventoryReceipt[]

  @@unique([restaurantId, number])
  @@index([restaurantId, status, number])
  @@index([supplierId])
  @@map("inventory_purchase_orders")
}

enum InventorySupplyUnit {
  G
  KG
  ML
  L
  UNIT
  PACK
  BOX
  BAG
}

model InventoryPurchaseOrderLine {
  id               String               @id @default(uuid()) @db.Uuid
  purchaseOrderId  String               @map("purchase_order_id") @db.Uuid
  stockItemId      String               @map("stock_item_id") @db.Uuid
  quantity         Decimal              @db.Decimal(12, 3)
  quantityReceived Decimal              @default(0) @map("quantity_received") @db.Decimal(12, 3)
  unitCost         Decimal              @map("unit_cost") @db.Decimal(18, 8)
  unit             InventorySupplyUnit?
  packageQuantity  Decimal?             @map("package_quantity") @db.Decimal(12, 3)
  packageUnit      Unit?                @map("package_unit")

  purchaseOrder InventoryPurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  stockItem     StockItem              @relation(fields: [stockItemId], references: [id])
  receiptLines  InventoryReceiptLine[]

  @@unique([purchaseOrderId, stockItemId])
  @@index([stockItemId])
  @@map("inventory_purchase_order_lines")
}

model InventoryReceipt {
  id                    String    @id @default(uuid()) @db.Uuid
  restaurantId          String    @map("restaurant_id") @db.Uuid
  supplierId            String    @map("supplier_id") @db.Uuid
  purchaseOrderId       String?   @map("purchase_order_id") @db.Uuid
  actorId               String    @map("actor_id") @db.Uuid
  number                Int
  idempotencyKey        String    @map("idempotency_key") @db.Uuid
  requestHash           String    @map("request_hash") @db.VarChar(64)
  notes                 String    @default("") @db.VarChar(500)
  /// Details printed on the supplier's invoice (set when the receipt came from an invoice).
  supplierInvoiceNumber String?   @map("supplier_invoice_number") @db.VarChar(50)
  supplierInvoiceDate   DateTime? @map("supplier_invoice_date") @db.Date
  invoiceTotal          Decimal?  @map("invoice_total") @db.Decimal(14, 2)
  /// `{ cgst, sgst, igst, roundOff }` as decimal strings.
  taxBreakdown          Json?     @map("tax_breakdown")
  scanJobId             String?   @map("scan_job_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  restaurant    Restaurant              @relation(fields: [restaurantId], references: [id])
  supplier      InventorySupplier       @relation(fields: [supplierId], references: [id])
  purchaseOrder InventoryPurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  actor         User                    @relation(fields: [actorId], references: [id])
  lines         InventoryReceiptLine[]
  movements     StockMovement[]

  @@unique([restaurantId, number])
  @@unique([restaurantId, idempotencyKey])
  @@index([supplierId])
  @@index([purchaseOrderId])
  @@index([restaurantId, supplierId, supplierInvoiceNumber])
  @@map("inventory_receipts")
}

model InventoryReceiptLine {
  id                  String               @id @default(uuid()) @db.Uuid
  receiptId           String               @map("receipt_id") @db.Uuid
  stockItemId         String               @map("stock_item_id") @db.Uuid
  purchaseOrderLineId String?              @map("purchase_order_line_id") @db.Uuid
  quantity            Decimal              @db.Decimal(12, 3)
  unitCost            Decimal              @map("unit_cost") @db.Decimal(18, 8)
  unit                InventorySupplyUnit?
  packageQuantity     Decimal?             @map("package_quantity") @db.Decimal(12, 3)
  packageUnit         Unit?                @map("package_unit")
  batchNumber         String               @map("batch_number") @db.VarChar(80)
  expiryDate          DateTime?            @map("expiry_date") @db.Date

  receipt           InventoryReceipt            @relation(fields: [receiptId], references: [id])
  stockItem         StockItem                   @relation(fields: [stockItemId], references: [id])
  purchaseOrderLine InventoryPurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id])
  batch             StockBatch?

  @@index([receiptId])
  @@index([stockItemId])
  @@index([purchaseOrderLineId])
  @@map("inventory_receipt_lines")
}

// ----------------------------------------------------------------------------
// Orders
// ----------------------------------------------------------------------------

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  restaurantId    String      @map("restaurant_id") @db.Uuid
  tableId         String      @map("table_id") @db.Uuid // [C1] dine-in anchor
  reservationId   String?     @map("reservation_id") @db.Uuid // [C1] nullable: walk-ins have no reservation
  createdByUserId String      @map("created_by_user_id") @db.Uuid
  status          OrderStatus @default(OPEN)
  notes           String?     @db.VarChar(255)
  openedAt        DateTime    @map("opened_at") @db.Timestamptz(6)
  completedAt     DateTime?   @map("completed_at") @db.Timestamptz(6)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant    Restaurant      @relation(fields: [restaurantId], references: [id])
  table         RestaurantTable @relation(fields: [tableId], references: [id])
  reservation   Reservation?    @relation(fields: [reservationId], references: [id])
  createdByUser User            @relation("OrderCreatedBy", fields: [createdByUserId], references: [id])
  items         OrderItem[]
  kots          Kot[]
  bill          Bill?

  @@index([restaurantId])
  @@index([restaurantId, createdAt])
  @@index([restaurantId, status, completedAt])
  @@index([tableId])
  @@index([reservationId])
  @@index([createdByUserId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id                  String          @id @default(uuid()) @db.Uuid
  orderId             String          @map("order_id") @db.Uuid
  menuItemId          String          @map("menu_item_id") @db.Uuid
  /// Portion variant ordered, when the item has variants.
  variantId           String?         @map("variant_id") @db.Uuid
  /// Variant name snapshot, so KOT/bill text survives a later rename.
  variantName         String?         @map("variant_name") @db.VarChar(50)
  quantity            Int
  /// Price snapshot at time of ordering — insulates the bill from later menu edits.
  unitPrice           Decimal         @map("unit_price") @db.Decimal(12, 2)
  specialInstructions String?         @map("special_instructions") @db.VarChar(255)
  status              OrderItemStatus @default(ACTIVE)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  order    Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem         @relation(fields: [menuItemId], references: [id])
  variant  MenuItemVariant? @relation(fields: [variantId], references: [id])
  kotItems KotItem[]

  @@index([orderId])
  @@index([menuItemId])
  @@index([variantId])
  @@map("order_items")
}

// ----------------------------------------------------------------------------
// Kitchen Order Tickets (KOT)
// ----------------------------------------------------------------------------

model Kot {
  id              String         @id @default(uuid()) @db.Uuid
  restaurantId    String         @map("restaurant_id") @db.Uuid
  orderId         String         @map("order_id") @db.Uuid
  createdByUserId String         @map("created_by_user_id") @db.Uuid
  kotNumber       String         @map("kot_number") @db.VarChar(50)
  destination     KotDestination
  status          KotStatus      @default(PENDING)
  completedAt     DateTime?      @map("completed_at") @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant    Restaurant @relation(fields: [restaurantId], references: [id])
  order         Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdByUser User       @relation("KotCreatedBy", fields: [createdByUserId], references: [id])
  items         KotItem[]

  @@unique([restaurantId, kotNumber])
  @@index([restaurantId])
  @@index([orderId])
  @@index([createdByUserId])
  @@map("kots")
}

model KotItem {
  id          String    @id @default(uuid()) @db.Uuid
  kotId       String    @map("kot_id") @db.Uuid
  orderItemId String    @map("order_item_id") @db.Uuid
  quantity    Int
  status      KotStatus @default(PENDING)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  kot       Kot       @relation(fields: [kotId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@index([kotId])
  @@index([orderItemId])
  @@map("kot_items")
}

// ----------------------------------------------------------------------------
// Billing & payments
// ----------------------------------------------------------------------------

model BillCancellationReason {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  code         String   @db.VarChar(50)
  name         String   @db.VarChar(255)
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@unique([restaurantId, code])
  @@index([restaurantId, isActive, sortOrder])
  @@map("bill_cancellation_reasons")
}

model Bill {
  id                 String     @id @default(uuid()) @db.Uuid
  restaurantId       String     @map("restaurant_id") @db.Uuid
  /// MVP: one bill per order (split bills excluded).
  orderId            String     @unique @map("order_id") @db.Uuid
  generatedByUserId  String     @map("generated_by_user_id") @db.Uuid
  billNumber         String     @map("bill_number") @db.VarChar(50)
  subtotal           Decimal    @default(0) @db.Decimal(12, 2)
  discountAmount     Decimal    @default(0) @map("discount_amount") @db.Decimal(12, 2)
  cancellationReason String?    @map("cancellation_reason") @db.VarChar(255)
  gstRate            Decimal    @default(0) @map("gst_rate") @db.Decimal(5, 2)
  gstAmount          Decimal    @default(0) @map("gst_amount") @db.Decimal(12, 2)
  totalAmount        Decimal    @default(0) @map("total_amount") @db.Decimal(12, 2)
  status             BillStatus @default(OPEN)
  generatedAt        DateTime   @map("generated_at") @db.Timestamptz(6)
  paidAt             DateTime?  @map("paid_at") @db.Timestamptz(6)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant      Restaurant @relation(fields: [restaurantId], references: [id])
  order           Order      @relation(fields: [orderId], references: [id])
  generatedByUser User       @relation("BillGeneratedBy", fields: [generatedByUserId], references: [id])
  payments        Payment[]

  @@unique([restaurantId, billNumber]) // bill number unique per tenant
  @@index([restaurantId])
  @@index([restaurantId, status, paidAt])
  @@index([generatedByUserId])
  @@index([status])
  @@map("bills")
}

model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  billId           String        @map("bill_id") @db.Uuid
  recordedByUserId String        @map("recorded_by_user_id") @db.Uuid
  paymentMethod    PaymentMethod @map("payment_method")
  amount           Decimal       @db.Decimal(12, 2)
  /// MVP permits one COMPLETED settlement per bill (enforced by a partial
  /// unique index added via raw migration — see [H6] header note). Retries may
  /// create additional PENDING/FAILED records.
  status           PaymentStatus @default(COMPLETED)
  referenceNumber  String?       @map("reference_number") @db.VarChar(255)
  paidAt           DateTime?     @map("paid_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  // Append-only: no updated_at by design.

  bill           Bill @relation(fields: [billId], references: [id], onDelete: Cascade)
  recordedByUser User @relation("PaymentRecordedBy", fields: [recordedByUserId], references: [id])

  @@index([billId])
  @@index([recordedByUserId])
  @@map("payments")
}

// ----------------------------------------------------------------------------
// AI assistance (REST-89): scan jobs, usage and global reference data
// ----------------------------------------------------------------------------

enum AiJobKind {
  MENU_SCAN
  INVOICE_SCAN
  RECIPE_DRAFT
}

enum AiJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  CANCELLED
}

enum AiJobContext {
  ONBOARDING
  POST_ONBOARDING
}

/// A long-running AI extraction / drafting job. Results only ever feed a draft the owner reviews.
model AiJob {
  id              String       @id @default(uuid()) @db.Uuid
  restaurantId    String       @map("restaurant_id") @db.Uuid
  createdByUserId String       @map("created_by_user_id") @db.Uuid
  kind            AiJobKind
  status          AiJobStatus  @default(QUEUED)
  context         AiJobContext
  /// Settings and page metadata the job runs with.
  input           Json         @default("{}")
  /// Summary: per-page statuses, invoice header, dropped rows.
  result          Json?
  pagesTotal      Int          @default(0) @map("pages_total")
  pagesDone       Int          @default(0) @map("pages_done")
  errorCode       String?      @map("error_code") @db.VarChar(40)
  attempts        Int          @default(0)
  imagesPurgedAt  DateTime?    @map("images_purged_at") @db.Timestamptz(6)
  startedAt       DateTime?    @map("started_at") @db.Timestamptz(6)
  finishedAt      DateTime?    @map("finished_at") @db.Timestamptz(6)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id])
  items      AiJobItem[]

  @@index([restaurantId, kind, createdAt])
  @@index([status])
  @@map("ai_jobs")
}

/// One validated result row of a job (menu row, invoice line or recipe draft), in arrival order.
model AiJobItem {
  id         String   @id @default(uuid()) @db.Uuid
  jobId      String   @map("job_id") @db.Uuid
  seq        Int
  page       Int?
  data       Json
  confidence Int
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  job AiJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, seq])
  @@map("ai_job_items")
}

/// Daily AI usage per restaurant: enforces scan limits and records token spend.
model AiUsage {
  restaurantId String    @map("restaurant_id") @db.Uuid
  day          DateTime  @db.Date
  kind         AiJobKind
  jobs         Int       @default(0)
  inputTokens  Int       @default(0) @map("input_tokens")
  outputTokens Int       @default(0) @map("output_tokens")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@id([restaurantId, day, kind])
  @@map("ai_usage")
}

enum IngredientPriceSource {
  SEED
  AI
}

enum PortionStyle {
  LIGHT
  STANDARD
  GENEROUS
}

/// Global ingredient reference (no tenant data): canonical names, aliases and estimated market prices.
model IngredientCatalog {
  id                    String                @id @default(uuid()) @db.Uuid
  canonicalName         String                @unique @map("canonical_name") @db.VarChar(150)
  baseUnit              InventoryBaseUnit     @map("base_unit")
  aliases               String[]              @default([])
  /// Estimated ₹ per base unit (g, ml or unit).
  estimatedPricePerBase Decimal               @map("estimated_price_per_base") @db.Decimal(18, 8)
  priceSource           IngredientPriceSource @default(SEED) @map("price_source")
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("ingredient_catalog")
}

/// Global cache of AI-drafted recipes by normalised dish name (no tenant data).
model RecipeTemplate {
  id           String       @id @default(uuid()) @db.Uuid
  dishKey      String       @map("dish_key") @db.VarChar(200)
  portionStyle PortionStyle @map("portion_style")
  /// `[{ ingredient, quantity, unit }]`
  lines        Json
  note         String?      @db.VarChar(500)
  model        String       @db.VarChar(80)
  hits         Int          @default(0)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([dishKey, portionStyle])
  @@map("recipe_templates")
}
