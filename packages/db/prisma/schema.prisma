// Restaurant Management System — Prisma schema
// -----------------------------------------------------------------------------
// Conventions:
//   * PostgreSQL UUID primary keys (`@default(uuid())`).
//   * All timestamps are `timestamptz` (@db.Timestamptz) stored in UTC.
//   * DB identifiers are snake_case (@map / @@map); Prisma fields are camelCase.
//   * Every table is tenant-scoped via `restaurant_id`.
//
// Review fixes applied (critical + high):
//   [C1] orders.table_id added (dine-in anchor); orders.reservation_id nullable
//        so walk-ins don't need a fake reservation.
//   [C2] All datetime columns use @db.Timestamptz (true timezone-aware storage).
//   [C3] Enum values enforced via native Postgres enums (see `enum` blocks).
//   [H4] Indexes on every foreign key + common tenant/status filters.
//   [H5] Per-tenant uniqueness (email, bill_number, table_number, kot_number,
//        role name, table status code) instead of global uniqueness.
//   [H6] "One completed payment per bill" — Prisma cannot express a partial
//        unique index. Add this in a follow-up raw migration:
//          CREATE UNIQUE INDEX payments_one_completed_per_bill
//            ON payments (bill_id) WHERE status = 'COMPLETED';
//
// RBAC (agreed): `permissions` and `user_roles` tables dropped. Permission keys
// are the source of truth in @rms/permissions; roles are per-restaurant and
// seeded on signup; each user has exactly one role.
// -----------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enums (replace the varchar+comment "enums" from the original schema)
// ----------------------------------------------------------------------------

enum RestaurantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum RoleAuditAction {
  CREATED
  UPDATED
  RESET
  DELETED
}

enum UserStatus {
  INVITED
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum UserTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  STAFF_INVITE
}

enum AuthRateLimitAction {
  RESEND_VERIFICATION_MINUTE
  RESEND_VERIFICATION_HOUR
  FORGOT_PASSWORD_EMAIL
  FORGOT_PASSWORD_IP
  RESEND_STAFF_INVITE_MINUTE
  RESEND_STAFF_INVITE_HOUR
  STAFF_PASSWORD_RESET_HOUR
  QR_RESOLVE_MINUTE
  QR_JOIN_WINDOW
  QR_GUEST_WRITE_MINUTE
  AUTHENTICATOR_ATTEMPT
}

enum NotificationType {
  KOT_SENT             @map("kot.sent")
  KOT_READY            @map("kot.ready")
  RESERVATION_CREATED  @map("reservation.created")
  QR_ORDER_SUBMITTED   @map("qr.order.submitted")
  QR_ORDER_ESCALATED   @map("qr.order.escalated")
  QR_NO_CAPTAIN        @map("qr.no-captain")
  QR_BILL_REQUESTED    @map("qr.bill.requested")
  QR_CALL_SERVER       @map("qr.call-server")
  QR_PAYMENT_REQUESTED @map("qr.payment.requested")
}

enum NotificationEntity {
  ORDER       @map("order")
  RESERVATION @map("reservation")
  QR_ROUND    @map("qr-round")
  QR_SESSION  @map("qr-session")
  TABLE       @map("table")
}

/// Where a kitchen ticket came from: a staff-entered order or an approved guest QR round.
enum KotSource {
  STAFF
  QR
}

/// QR table session: one OPEN session per table, shared by every phone that scans it.
enum QrSessionStatus {
  OPEN
  CLOSED
}

/// Approval lifecycle of a guest round. Kitchen progress is derived from its KOTs.
enum QrRoundStatus {
  AWAITING_APPROVAL
  APPROVED
  REJECTED
}

enum QrRoundItemStatus {
  ACTIVE
  REMOVED
  OUT_OF_STOCK
}

enum QrSplitMode {
  FULL
  EQUAL
  BY_ITEM
  CUSTOM
}

enum QrShareStatus {
  UNPAID
  PAYMENT_REQUESTED
  PAID
}

enum QrAlertKind {
  NO_CAPTAIN
  ESCALATION
}

enum QrAlertStatus {
  OPEN
  RESOLVED
  DISMISSED
}

/// Food vs bar — drives menu classification and Kitchen/Bar routing.
enum ServingType {
  FOOD
  BAR
}

enum ReservationStatus {
  BOOKED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum OrderStatus {
  OPEN
  SUBMITTED
  COMPLETED
  CANCELLED
}

enum OrderItemStatus {
  ACTIVE
  CANCELLED
}

enum KotDestination {
  KITCHEN
  BAR
}

/// Shared by kots and kot_items (identical lifecycle).
enum KotStatus {
  PENDING
  PREPARING
  READY
  COMPLETED
}

enum BillStatus {
  OPEN
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

// ----------------------------------------------------------------------------
// Tenant
// ----------------------------------------------------------------------------

model Restaurant {
  thermalPrinters       ThermalPrinter[]
  thermalPrintConnector ThermalPrintConnector?
  logo                  RestaurantLogo?
  foodIncidents         FoodIncident[]
  foodIncidentBatches   FoodIncidentBatch[]
  foodIncidentEntries   FoodIncidentEntry[]
  id                    String                 @id @default(uuid()) @db.Uuid
  name                  String                 @db.VarChar(255)
  gstNumber             String?                @map("gst_number") @db.VarChar(50)
  defaultGstRate        Decimal                @default(0) @map("default_gst_rate") @db.Decimal(5, 2)
  maxDiscountPercent    Decimal                @default(20) @map("max_discount_percent") @db.Decimal(5, 2)
  address               String?                @db.VarChar(500)
  currency              String                 @default("INR") @db.VarChar(10)
  timezone              String                 @default("Asia/Kolkata") @db.VarChar(100)
  status                RestaurantStatus       @default(ACTIVE)
  /// Null while the owner's guided setup is pending; set once by `POST /onboarding/complete`.
  onboardingCompletedAt DateTime?              @map("onboarding_completed_at") @db.Timestamptz(6)
  /// Master switch for guest QR ordering (REST-88). Off by default.
  qrOrderingEnabled     Boolean                @default(false) @map("qr_ordering_enabled")
  /// Minutes a guest round may wait for its captain before managers are alerted (1–15).
  qrEscalationMinutes   Int                    @default(3) @map("qr_escalation_minutes")
  /// Phone number on the guest "Call restaurant" button.
  guestPhone            String?                @map("guest_phone") @db.VarChar(30)
  /// Guest app accent (#RRGGBB). Null uses the default; must give 4.5:1 with white text.
  brandColor            String?                @map("brand_color") @db.VarChar(7)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  users                   User[]
  userTokens              UserToken[]
  roles                   Role[]
  roleAuditLogs           RoleAuditLog[]
  diningSections          DiningSection[]
  tableStatuses           TableStatus[]
  tables                  RestaurantTable[]
  guests                  Guest[]
  reservations            Reservation[]
  menuCategories          MenuCategory[]
  menuItems               MenuItem[]
  menuItemRevisions       MenuItemRevision[]
  stockItems              StockItem[]
  stockBatches            StockBatch[]
  stockMovements          StockMovement[]
  inventorySuppliers      InventorySupplier[]
  inventoryPurchaseOrders InventoryPurchaseOrder[]
  inventoryReceipts       InventoryReceipt[]
  orders                  Order[]
  kots                    Kot[]
  preparationEvents       PreparationEvent[]
  operatingTasks          OperatingTask[]
  operatingTaskEvents     OperatingTaskEvent[]
  attendanceSessions      AttendanceSession[]
  attendanceEvents        AttendanceEvent[]
  attendanceCorrections   AttendanceCorrection[]
  staffShifts             StaffShift[]
  staffAvailability       StaffAvailability[]
  staffLeave              StaffLeave[]
  workforceEvents         WorkforceEvent[]
  bills                   Bill[]
  notifications           Notification[]
  billCancellationReasons BillCancellationReason[]
  onboardingDraft         OnboardingDraft?
  upiQr                   RestaurantUpiQr?
  qrSessions              QrSession[]
  qrGuests                QrGuest[]
  qrRounds                QrRound[]
  qrBillShares            QrBillShare[]
  qrAlerts                QrAlert[]
  pushSubscriptions       PushSubscription[]

  @@map("restaurants")
}

/// The owner's in-progress setup. Nothing in it touches business tables until onboarding completes,
/// at which point the row is deleted. `version` guards against two tabs overwriting each other.
model OnboardingDraft {
  restaurantId String   @id @map("restaurant_id") @db.Uuid
  currentStep  Int      @default(0) @map("current_step")
  skippedSteps Int[]    @default([]) @map("skipped_steps")
  data         Json     @default("{}")
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("onboarding_drafts")
}

// ----------------------------------------------------------------------------
// Identity & Access
// ----------------------------------------------------------------------------

model User {
  foodIncidentsCreated        FoodIncident[]      @relation("IncidentCreator")
  foodIncidentsResolved       FoodIncident[]      @relation("IncidentResolver")
  foodIncidentEntries         FoodIncidentEntry[]
  id                          String              @id @default(uuid()) @db.Uuid
  restaurantId                String              @map("restaurant_id") @db.Uuid
  roleId                      String              @map("role_id") @db.Uuid
  name                        String              @db.VarChar(255)
  email                       String              @unique @db.VarChar(255) // globally unique across all tenants
  phone                       String?             @db.VarChar(30)
  /// Authentication-only; never expose through the API.
  passwordHash                String?             @map("password_hash") @db.VarChar(255)
  status                      UserStatus          @default(ACTIVE)
  emailVerifiedAt             DateTime?           @map("email_verified_at") @db.Timestamptz(6)
  authVersion                 Int                 @default(0) @map("auth_version")
  authenticatorSecret         String?             @map("authenticator_secret")
  authenticatorPending        String?             @map("authenticator_pending")
  authenticatorPendingUntil   DateTime?           @map("authenticator_pending_until") @db.Timestamptz(6)
  authenticatorCounter        Int?                @map("authenticator_counter")
  authenticatorRecoveryHashes String[]            @default([]) @map("authenticator_recovery_hashes")
  authenticatorVersion        Int                 @default(0) @map("authenticator_version")
  /// Set for accounts created with a generated one-time password; cleared on the first password change.
  mustChangePassword          Boolean             @default(false) @map("must_change_password")
  lastLoginAt                 DateTime?           @map("last_login_at") @db.Timestamptz(6)
  /// Last authenticated request (throttled to one write a minute). Drives captain availability.
  lastSeenAt                  DateTime?           @map("last_seen_at") @db.Timestamptz(6)
  createdAt                   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id])
  role       Role        @relation(fields: [roleId], references: [id]) // Restrict (default): can't delete a role in use
  tokens     UserToken[]

  reservationsCaptained   Reservation[]            @relation("ReservationCaptain")
  reservationsCreated     Reservation[]            @relation("ReservationCreatedBy")
  tablesCaptained         RestaurantTable[]        @relation("TableCaptain")
  ordersCreated           Order[]                  @relation("OrderCreatedBy")
  kotsCreated             Kot[]                    @relation("KotCreatedBy")
  preparationEvents       PreparationEvent[]
  billsGenerated          Bill[]                   @relation("BillGeneratedBy")
  paymentsRecorded        Payment[]                @relation("PaymentRecordedBy")
  notifications           Notification[]
  stockMovements          StockMovement[]
  inventoryPurchaseOrders InventoryPurchaseOrder[]
  inventoryReceipts       InventoryReceipt[]
  roleAuditLogs           RoleAuditLog[]
  kotsApproved            Kot[]                    @relation("KotApprovedBy")
  qrRoundsOwned           QrRound[]                @relation("QrRoundOwner")
  qrRoundsApproved        QrRound[]                @relation("QrRoundApprovedBy")
  qrRoundsRejected        QrRound[]                @relation("QrRoundRejectedBy")
  qrSharesRecorded        QrBillShare[]            @relation("QrShareRecordedBy")
  qrAlertsResolved        QrAlert[]                @relation("QrAlertResolvedBy")
  pushSubscriptions       PushSubscription[]

  menuItemRevisions      MenuItemRevision[]
  operatingTasksAssigned OperatingTask[]      @relation("TaskAssignee")
  operatingTasksCreated  OperatingTask[]      @relation("TaskCreator")
  operatingTaskEvents    OperatingTaskEvent[]

  attendanceSessions             AttendanceSession[]
  attendanceEvents               AttendanceEvent[]
  attendanceCorrections          AttendanceCorrection[] @relation("AttendanceSubject")
  attendanceCorrectionsRequested AttendanceCorrection[] @relation("AttendanceRequester")
  attendanceCorrectionsReviewed  AttendanceCorrection[] @relation("AttendanceReviewer")

  staffShifts             StaffShift[]        @relation("ShiftSubject")
  staffShiftsCreated      StaffShift[]        @relation("ShiftCreator")
  staffAvailability       StaffAvailability[]
  staffLeave              StaffLeave[]        @relation("LeaveSubject")
  staffLeaveRequested     StaffLeave[]        @relation("LeaveRequester")
  staffLeaveReviewed      StaffLeave[]        @relation("LeaveReviewer")
  workforceEvents         WorkforceEvent[]    @relation("WorkforceSubject")
  workforceEventsRecorded WorkforceEvent[]    @relation("WorkforceRecorder")

  @@index([restaurantId])
  @@index([roleId])
  @@map("users")
}

model UserToken {
  id           String        @id @default(uuid()) @db.Uuid
  restaurantId String        @map("restaurant_id") @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  type         UserTokenType
  tokenHash    String        @unique @map("token_hash") @db.VarChar(64)
  expiresAt    DateTime      @map("expires_at") @db.Timestamptz(6)
  usedAt       DateTime?     @map("used_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([userId])
  @@index([userId, type, createdAt])
  @@index([expiresAt])
  @@map("user_tokens")
}

/// Pre-authentication abuse controls cannot always be tenant scoped. Subject keys are HMAC hashes;
/// raw email addresses and IP addresses are never persisted.
model AuthRateLimitCounter {
  id          String              @id @default(uuid()) @db.Uuid
  action      AuthRateLimitAction
  subjectHash String              @map("subject_hash") @db.VarChar(64)
  windowStart DateTime            @map("window_start") @db.Timestamptz(6)
  count       Int                 @default(1)
  expiresAt   DateTime            @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([action, subjectHash, windowStart])
  @@index([expiresAt])
  @@map("auth_rate_limit_counters")
}

model Notification {
  id              String             @id @default(uuid()) @db.Uuid
  restaurantId    String             @map("restaurant_id") @db.Uuid
  recipientUserId String             @map("recipient_user_id") @db.Uuid
  type            NotificationType
  title           String             @db.VarChar(255)
  body            String
  entity          NotificationEntity
  entityId        String             @map("entity_id") @db.Uuid
  tableId         String?            @map("table_id") @db.Uuid
  readAt          DateTime?          @map("read_at") @db.Timestamptz(6)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  recipient  User       @relation(fields: [recipientUserId], references: [id])

  @@index([restaurantId, recipientUserId, createdAt, id])
  @@index([restaurantId, recipientUserId, readAt])
  @@map("notifications")
}

model Role {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  /// Seeded from @rms/permissions on signup: OWNER, MANAGER, CAPTAIN, RECEPTION, KITCHEN_STAFF,
  /// BAR_STAFF. Custom roles are free-form names, unique per restaurant.
  name         String   @db.VarChar(100)
  description  String?  @db.VarChar(255)
  /// Seeded system roles — protect from delete/rename in app logic.
  isSystem     Boolean  @default(false) @map("is_system")
  /// Account Owner bypass role: passes every permission check and carries no role_permissions rows.
  /// At most one per restaurant (partial unique index in a raw migration).
  isOwner      Boolean  @default(false) @map("is_owner")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant  Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  users       User[]
  permissions RolePermission[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@map("roles")
}

/// Who changed which role and which permission keys were added or removed.
model RoleAuditLog {
  id           String          @id @default(uuid()) @db.Uuid
  restaurantId String          @map("restaurant_id") @db.Uuid
  /// Not a relation: the entry must outlive the role it describes.
  roleId       String          @map("role_id") @db.Uuid
  roleName     String          @map("role_name") @db.VarChar(100)
  actorUserId  String?         @map("actor_user_id") @db.Uuid
  action       RoleAuditAction
  addedKeys    String[]        @map("added_keys")
  removedKeys  String[]        @map("removed_keys")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  actor      User?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@map("role_audit_logs")
}

model RolePermission {
  roleId        String   @map("role_id") @db.Uuid
  /// Validated against @rms/permissions at write time; code is the source of truth.
  permissionKey String   @map("permission_key") @db.VarChar(150)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

// ----------------------------------------------------------------------------
// Floor: sections, table statuses, tables
// ----------------------------------------------------------------------------

model DiningSection {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  name         String   @db.VarChar(150)
  description  String?  @db.VarChar(255)
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant        @relation(fields: [restaurantId], references: [id])
  tables     RestaurantTable[]

  @@index([restaurantId])
  @@map("dining_sections")
}

model TableStatus {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  code         String   @db.VarChar(50)
  name         String   @db.VarChar(100)
  sortOrder    Int      @default(0) @map("sort_order")
  /// System lifecycle statuses may be protected from deletion.
  isSystem     Boolean  @default(false) @map("is_system")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant        @relation(fields: [restaurantId], references: [id])
  tables     RestaurantTable[]

  @@unique([restaurantId, code])
  @@index([restaurantId])
  @@map("table_statuses")
}

model RestaurantTable {
  id              String   @id @default(uuid()) @db.Uuid
  restaurantId    String   @map("restaurant_id") @db.Uuid
  sectionId       String   @map("section_id") @db.Uuid
  currentStatusId String   @map("current_status_id") @db.Uuid
  captainUserId   String?  @map("captain_user_id") @db.Uuid
  tableNumber     String   @map("table_number") @db.VarChar(50)
  capacity        Int
  isActive        Boolean  @default(true) @map("is_active")
  /// UTC timestamp of the last status transition.
  statusChangedAt DateTime @default(now()) @map("status_changed_at") @db.Timestamptz(6)
  /// Unguessable, rotatable token printed on the table's QR card (REST-88). Never derived from the
  /// table number; regenerating it invalidates the old card. Globally unique so the tenant is
  /// resolved from the token alone.
  qrToken         String   @unique @default(dbgenerated("(replace((gen_random_uuid())::text, '-'::text, ''::text) || replace((gen_random_uuid())::text, '-'::text, ''::text))")) @map("qr_token") @db.VarChar(64)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id])
  section       DiningSection @relation(fields: [sectionId], references: [id])
  currentStatus TableStatus   @relation(fields: [currentStatusId], references: [id])
  captain       User?         @relation("TableCaptain", fields: [captainUserId], references: [id])
  reservations  Reservation[]
  orders        Order[]
  qrSessions    QrSession[]
  qrRounds      QrRound[]
  qrAlerts      QrAlert[]

  // Case-insensitive uniqueness per section is enforced by a raw index on
  // (restaurant_id, section_id, lower(table_number))
  // (20261125120000_tables_number_unique_per_section); Prisma can't express it.
  @@unique([restaurantId, sectionId, tableNumber])
  @@index([restaurantId])
  @@index([sectionId])
  @@index([currentStatusId])
  @@index([captainUserId])
  @@map("restaurant_tables")
}

// ----------------------------------------------------------------------------
// Guests & reservations
// ----------------------------------------------------------------------------

model Guest {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  guestName    String   @map("guest_name") @db.VarChar(255)
  phoneNumber  String   @map("phone_number") @db.VarChar(30)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id])
  reservations Reservation[]
  qrGuests     QrGuest[]

  @@unique([restaurantId, phoneNumber])
  @@map("guests")
}

model Reservation {
  id                 String            @id @default(uuid()) @db.Uuid
  restaurantId       String            @map("restaurant_id") @db.Uuid
  guestId            String            @map("guest_id") @db.Uuid
  tableId            String?           @map("table_id") @db.Uuid
  captainUserId      String?           @map("captain_user_id") @db.Uuid
  createdByUserId    String            @map("created_by_user_id") @db.Uuid
  reservationAt      DateTime          @map("reservation_at") @db.Timestamptz(6)
  partySize          Int               @map("party_size")
  status             ReservationStatus @default(BOOKED)
  notes              String?           @db.VarChar(255)
  cancellationReason String?           @map("cancellation_reason") @db.VarChar(255)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant    Restaurant       @relation(fields: [restaurantId], references: [id])
  guest         Guest            @relation(fields: [guestId], references: [id])
  table         RestaurantTable? @relation(fields: [tableId], references: [id])
  captain       User?            @relation("ReservationCaptain", fields: [captainUserId], references: [id])
  createdByUser User             @relation("ReservationCreatedBy", fields: [createdByUserId], references: [id])
  orders        Order[]

  @@index([restaurantId])
  @@index([guestId])
  @@index([tableId])
  @@index([createdByUserId])
  @@index([captainUserId])
  @@map("reservations")
}

// ----------------------------------------------------------------------------
// Menu
// ----------------------------------------------------------------------------

model MenuCategory {
  id           String      @id @default(uuid()) @db.Uuid
  restaurantId String      @map("restaurant_id") @db.Uuid
  name         String      @db.VarChar(150)
  categoryType ServingType @map("category_type")
  sortOrder    Int         @default(0) @map("sort_order")
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  items      MenuItem[]

  @@index([restaurantId])
  @@map("menu_categories")
}

model MenuItem {
  id             String      @id @default(uuid()) @db.Uuid
  restaurantId   String      @map("restaurant_id") @db.Uuid
  categoryId     String      @map("category_id") @db.Uuid
  name           String      @db.VarChar(255)
  description    String?     @db.VarChar(255)
  price          Decimal     @db.Decimal(12, 2)
  /// FOOD or BAR — used for Kitchen/Bar routing.
  itemType       ServingType @map("item_type")
  isAvailable    Boolean     @default(true) @map("is_available")
  isActive       Boolean     @default(true) @map("is_active")
  /// False marks "No recipe needed" (e.g. bottled drinks), which silences the missing-recipe prompt.
  recipeRequired Boolean     @default(true) @map("recipe_required")
  /// FSSAI marker for the guest menu: true = veg, false = non-veg, null = not shown.
  isVeg          Boolean?    @map("is_veg")
  customizations Json        @default("{\"variants\":[],\"groups\":[],\"components\":[]}")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant    Restaurant         @relation(fields: [restaurantId], references: [id])
  category      MenuCategory       @relation(fields: [categoryId], references: [id])
  orderItems    OrderItem[]
  recipeItems   RecipeItem[]
  qrCartItems   QrCartItem[]
  qrRoundItems  QrRoundItem[]
  revisions     MenuItemRevision[]
  kotComponents KotItem[]          @relation("KotComponent")

  @@index([restaurantId])
  @@index([categoryId])
  @@map("menu_items")
}

/// Append-only observations of menu prices and recipes. Existing history is never inferred.
model MenuItemRevision {
  id               String   @id @default(uuid()) @db.Uuid
  restaurantId     String   @map("restaurant_id") @db.Uuid
  menuItemId       String   @map("menu_item_id") @db.Uuid
  recordedByUserId String   @map("recorded_by_user_id") @db.Uuid
  revision         Int
  reason           String   @db.VarChar(30)
  snapshot         Json
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id])
  recordedBy User       @relation(fields: [recordedByUserId], references: [id])

  @@unique([menuItemId, revision])
  @@index([restaurantId, menuItemId, createdAt])
  @@index([recordedByUserId])
  @@map("menu_item_revisions")
}

/// Unit of measure for a recipe ingredient quantity.
enum Unit {
  G
  KG
  ML
  L
  UNIT
}

/// Restaurant ingredient master shared by recipes and inventory.
model StockItem {
  id              String             @id @default(uuid()) @db.Uuid
  restaurantId    String             @map("restaurant_id") @db.Uuid
  name            String             @db.VarChar(150)
  isActive        Boolean            @default(true) @map("is_active")
  sku             String?            @db.VarChar(60)
  baseUnit        InventoryBaseUnit? @map("base_unit")
  reorderLevel    Decimal            @default(0) @map("reorder_level") @db.Decimal(12, 3)
  currentStock    Decimal            @default(0) @map("current_stock") @db.Decimal(12, 3)
  averageUnitCost Decimal?           @map("average_unit_cost") @db.Decimal(18, 8)
  openedAt        DateTime?          @map("opened_at") @db.Timestamptz(6)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant    Restaurant                   @relation(fields: [restaurantId], references: [id])
  recipeItems   RecipeItem[]
  batches       StockBatch[]
  movements     StockMovement[]
  purchaseLines InventoryPurchaseOrderLine[]
  receiptLines  InventoryReceiptLine[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@map("stock_items")
}

/// One ingredient line of a menu item's recipe. Links the dish to stock; no stock is consumed here.
model RecipeItem {
  id          String   @id @default(uuid()) @db.Uuid
  menuItemId  String   @map("menu_item_id") @db.Uuid
  stockItemId String   @map("stock_item_id") @db.Uuid
  quantity    Decimal  @db.Decimal(12, 3)
  unit        Unit
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  menuItem  MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  stockItem StockItem @relation(fields: [stockItemId], references: [id])

  @@unique([menuItemId, stockItemId])
  @@index([menuItemId])
  @@index([stockItemId])
  @@map("recipe_items")
}

// ----------------------------------------------------------------------------
// Core inventory
// ----------------------------------------------------------------------------

enum InventoryBaseUnit {
  G
  ML
  UNIT
}

enum StockMovementKind {
  OPENING
  ADJUSTMENT
  RECEIPT
  WASTE
}

enum InventoryPurchaseStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model StockBatch {
  foodIncidentLinks FoodIncidentBatch[]
  id                String              @id @default(uuid()) @db.Uuid
  restaurantId      String              @map("restaurant_id") @db.Uuid
  stockItemId       String              @map("stock_item_id") @db.Uuid
  receiptLineId     String?             @unique @map("receipt_line_id") @db.Uuid
  batchNumber       String              @map("batch_number") @db.VarChar(80)
  quantityReceived  Decimal             @map("quantity_received") @db.Decimal(12, 3)
  quantityRemaining Decimal             @map("quantity_remaining") @db.Decimal(12, 3)
  unitCost          Decimal             @map("unit_cost") @db.Decimal(18, 8)
  expiryDate        DateTime?           @map("expiry_date") @db.Date
  receivedAt        DateTime            @default(now()) @map("received_at") @db.Timestamptz(6)

  restaurant  Restaurant            @relation(fields: [restaurantId], references: [id])
  stockItem   StockItem             @relation(fields: [stockItemId], references: [id])
  receiptLine InventoryReceiptLine? @relation(fields: [receiptLineId], references: [id])
  movements   StockMovement[]

  @@index([restaurantId, stockItemId, receivedAt])
  @@index([restaurantId, expiryDate])
  @@map("stock_batches")
}

model StockMovement {
  id           String            @id @default(uuid()) @db.Uuid
  restaurantId String            @map("restaurant_id") @db.Uuid
  stockItemId  String            @map("stock_item_id") @db.Uuid
  batchId      String?           @map("batch_id") @db.Uuid
  receiptId    String?           @map("receipt_id") @db.Uuid
  actorId      String            @map("actor_id") @db.Uuid
  kind         StockMovementKind
  quantity     Decimal           @db.Decimal(12, 3)
  unitCost     Decimal?          @map("unit_cost") @db.Decimal(18, 8)
  reason       String            @db.VarChar(500)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  restaurant Restaurant        @relation(fields: [restaurantId], references: [id])
  stockItem  StockItem         @relation(fields: [stockItemId], references: [id])
  batch      StockBatch?       @relation(fields: [batchId], references: [id])
  receipt    InventoryReceipt? @relation(fields: [receiptId], references: [id])
  actor      User              @relation(fields: [actorId], references: [id])

  @@index([restaurantId, createdAt])
  @@index([restaurantId, stockItemId, createdAt])
  @@index([batchId])
  @@index([receiptId])
  @@map("stock_movements")
}

model InventorySupplier {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  name         String   @db.VarChar(150)
  contactName  String   @default("") @map("contact_name") @db.VarChar(150)
  email        String   @default("") @db.VarChar(255)
  phone        String   @default("") @db.VarChar(30)
  address      String   @default("") @db.VarChar(500)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant               @relation(fields: [restaurantId], references: [id])
  purchases  InventoryPurchaseOrder[]
  receipts   InventoryReceipt[]

  @@unique([restaurantId, name])
  @@index([restaurantId, isActive])
  @@map("inventory_suppliers")
}

model InventoryPurchaseOrder {
  id           String                  @id @default(uuid()) @db.Uuid
  restaurantId String                  @map("restaurant_id") @db.Uuid
  supplierId   String                  @map("supplier_id") @db.Uuid
  actorId      String                  @map("actor_id") @db.Uuid
  number       Int
  status       InventoryPurchaseStatus @default(DRAFT)
  expectedDate DateTime?               @map("expected_date") @db.Date
  notes        String                  @default("") @db.VarChar(500)
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant                   @relation(fields: [restaurantId], references: [id])
  supplier   InventorySupplier            @relation(fields: [supplierId], references: [id])
  actor      User                         @relation(fields: [actorId], references: [id])
  lines      InventoryPurchaseOrderLine[]
  receipts   InventoryReceipt[]

  @@unique([restaurantId, number])
  @@index([restaurantId, status, number])
  @@index([supplierId])
  @@map("inventory_purchase_orders")
}

enum InventorySupplyUnit {
  G
  KG
  ML
  L
  UNIT
  PACK
  BOX
  BAG
}

model InventoryPurchaseOrderLine {
  id               String               @id @default(uuid()) @db.Uuid
  purchaseOrderId  String               @map("purchase_order_id") @db.Uuid
  stockItemId      String               @map("stock_item_id") @db.Uuid
  quantity         Decimal              @db.Decimal(12, 3)
  quantityReceived Decimal              @default(0) @map("quantity_received") @db.Decimal(12, 3)
  unitCost         Decimal              @map("unit_cost") @db.Decimal(18, 8)
  unit             InventorySupplyUnit?
  packageQuantity  Decimal?             @map("package_quantity") @db.Decimal(12, 3)
  packageUnit      Unit?                @map("package_unit")

  purchaseOrder InventoryPurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  stockItem     StockItem              @relation(fields: [stockItemId], references: [id])
  receiptLines  InventoryReceiptLine[]

  @@unique([purchaseOrderId, stockItemId])
  @@index([stockItemId])
  @@map("inventory_purchase_order_lines")
}

model InventoryReceipt {
  id              String   @id @default(uuid()) @db.Uuid
  restaurantId    String   @map("restaurant_id") @db.Uuid
  supplierId      String   @map("supplier_id") @db.Uuid
  purchaseOrderId String?  @map("purchase_order_id") @db.Uuid
  actorId         String   @map("actor_id") @db.Uuid
  number          Int
  idempotencyKey  String   @map("idempotency_key") @db.Uuid
  requestHash     String   @map("request_hash") @db.VarChar(64)
  notes           String   @default("") @db.VarChar(500)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  restaurant    Restaurant              @relation(fields: [restaurantId], references: [id])
  supplier      InventorySupplier       @relation(fields: [supplierId], references: [id])
  purchaseOrder InventoryPurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  actor         User                    @relation(fields: [actorId], references: [id])
  lines         InventoryReceiptLine[]
  movements     StockMovement[]

  @@unique([restaurantId, number])
  @@unique([restaurantId, idempotencyKey])
  @@index([supplierId])
  @@index([purchaseOrderId])
  @@map("inventory_receipts")
}

model InventoryReceiptLine {
  id                  String               @id @default(uuid()) @db.Uuid
  receiptId           String               @map("receipt_id") @db.Uuid
  stockItemId         String               @map("stock_item_id") @db.Uuid
  purchaseOrderLineId String?              @map("purchase_order_line_id") @db.Uuid
  quantity            Decimal              @db.Decimal(12, 3)
  unitCost            Decimal              @map("unit_cost") @db.Decimal(18, 8)
  unit                InventorySupplyUnit?
  packageQuantity     Decimal?             @map("package_quantity") @db.Decimal(12, 3)
  packageUnit         Unit?                @map("package_unit")
  batchNumber         String               @map("batch_number") @db.VarChar(80)
  expiryDate          DateTime?            @map("expiry_date") @db.Date

  receipt           InventoryReceipt            @relation(fields: [receiptId], references: [id])
  stockItem         StockItem                   @relation(fields: [stockItemId], references: [id])
  purchaseOrderLine InventoryPurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id])
  batch             StockBatch?

  @@index([receiptId])
  @@index([stockItemId])
  @@index([purchaseOrderLineId])
  @@map("inventory_receipt_lines")
}

// ----------------------------------------------------------------------------
// Orders
// ----------------------------------------------------------------------------

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  restaurantId    String      @map("restaurant_id") @db.Uuid
  tableId         String      @map("table_id") @db.Uuid // [C1] dine-in anchor
  reservationId   String?     @map("reservation_id") @db.Uuid // [C1] nullable: walk-ins have no reservation
  createdByUserId String      @map("created_by_user_id") @db.Uuid
  status          OrderStatus @default(OPEN)
  notes           String?     @db.VarChar(255)
  openedAt        DateTime    @map("opened_at") @db.Timestamptz(6)
  completedAt     DateTime?   @map("completed_at") @db.Timestamptz(6)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant    Restaurant      @relation(fields: [restaurantId], references: [id])
  table         RestaurantTable @relation(fields: [tableId], references: [id])
  reservation   Reservation?    @relation(fields: [reservationId], references: [id])
  createdByUser User            @relation("OrderCreatedBy", fields: [createdByUserId], references: [id])
  items         OrderItem[]
  kots          Kot[]
  bill          Bill?
  qrSessions    QrSession[]

  @@index([restaurantId])
  @@index([restaurantId, createdAt])
  @@index([restaurantId, status, completedAt])
  @@index([tableId])
  @@index([reservationId])
  @@index([createdByUserId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id                  String          @id @default(uuid()) @db.Uuid
  orderId             String          @map("order_id") @db.Uuid
  menuItemId          String          @map("menu_item_id") @db.Uuid
  quantity            Int
  /// Price snapshot at time of ordering — insulates the bill from later menu edits.
  unitPrice           Decimal         @map("unit_price") @db.Decimal(12, 2)
  nameSnapshot        String?         @map("name_snapshot") @db.Text
  /// Observed when the line is created; null for older lines. Snapshot IDs are historical facts.
  itemTypeSnapshot    ServingType?    @map("item_type_snapshot")
  selectionSnapshot   Json?           @map("selection_snapshot")
  recipeSnapshot      Json?           @map("recipe_snapshot")
  configurationKey    String?         @map("configuration_key") @db.VarChar(64)
  sentQuantity        Int?            @map("sent_quantity")
  specialInstructions String?         @map("special_instructions") @db.VarChar(255)
  status              OrderItemStatus @default(ACTIVE)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem     MenuItem      @relation(fields: [menuItemId], references: [id])
  kotItems     KotItem[]
  qrRoundItems QrRoundItem[]

  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}

// ----------------------------------------------------------------------------
// Kitchen Order Tickets (KOT)
// ----------------------------------------------------------------------------

model Kot {
  id                String             @id @default(uuid()) @db.Uuid
  restaurantId      String             @map("restaurant_id") @db.Uuid
  orderId           String             @map("order_id") @db.Uuid
  createdByUserId   String             @map("created_by_user_id") @db.Uuid
  kotNumber         String             @map("kot_number") @db.VarChar(50)
  destination       KotDestination
  status            KotStatus          @default(PENDING)
  /// QR tickets carry the round they came from and who approved it ("QR · approved by …").
  source            KotSource          @default(STAFF)
  qrRoundId         String?            @map("qr_round_id") @db.Uuid
  approvedByUserId  String?            @map("approved_by_user_id") @db.Uuid
  /// Set when the chef's Ready reached the guest tracker ("Guest notified · h:mm pm").
  guestNotifiedAt   DateTime?          @map("guest_notified_at") @db.Timestamptz(6)
  controlVersion    Int                @default(0) @map("control_version")
  acceptedAt        DateTime?          @map("accepted_at") @db.Timestamptz(6)
  heldAt            DateTime?          @map("held_at") @db.Timestamptz(6)
  holdReason        String?            @map("hold_reason") @db.VarChar(255)
  isPriority        Boolean            @default(false) @map("is_priority")
  targetSeconds     Int?               @map("target_seconds")
  preparationEvents PreparationEvent[]
  completedAt       DateTime?          @map("completed_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant     Restaurant @relation(fields: [restaurantId], references: [id])
  order          Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdByUser  User       @relation("KotCreatedBy", fields: [createdByUserId], references: [id])
  approvedByUser User?      @relation("KotApprovedBy", fields: [approvedByUserId], references: [id])
  qrRound        QrRound?   @relation(fields: [qrRoundId], references: [id])
  items          KotItem[]

  @@unique([restaurantId, kotNumber])
  @@index([restaurantId])
  @@index([orderId])
  @@index([createdByUserId])
  @@index([qrRoundId])
  @@index([approvedByUserId])
  @@map("kots")
}

model KotItem {
  id                   String    @id @default(uuid()) @db.Uuid
  kotId                String    @map("kot_id") @db.Uuid
  orderItemId          String    @map("order_item_id") @db.Uuid
  quantity             Int
  componentMenuItemId  String?   @map("component_menu_item_id") @db.Uuid
  nameSnapshot         String?   @map("name_snapshot") @db.Text
  instructionsSnapshot String?   @map("instructions_snapshot") @db.Text
  status               KotStatus @default(PENDING)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  kot               Kot       @relation(fields: [kotId], references: [id], onDelete: Cascade)
  orderItem         OrderItem @relation(fields: [orderItemId], references: [id])
  componentMenuItem MenuItem? @relation("KotComponent", fields: [componentMenuItemId], references: [id])

  @@index([kotId])
  @@index([orderItemId])
  @@index([componentMenuItemId])
  @@map("kot_items")
}

// ----------------------------------------------------------------------------
// Billing & payments
// ----------------------------------------------------------------------------

model BillCancellationReason {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  code         String   @db.VarChar(50)
  name         String   @db.VarChar(255)
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@unique([restaurantId, code])
  @@index([restaurantId, isActive, sortOrder])
  @@map("bill_cancellation_reasons")
}

model Bill {
  id                 String     @id @default(uuid()) @db.Uuid
  restaurantId       String     @map("restaurant_id") @db.Uuid
  /// MVP: one bill per order (split bills excluded).
  orderId            String     @unique @map("order_id") @db.Uuid
  generatedByUserId  String     @map("generated_by_user_id") @db.Uuid
  billNumber         String     @map("bill_number") @db.VarChar(50)
  subtotal           Decimal    @default(0) @db.Decimal(12, 2)
  discountAmount     Decimal    @default(0) @map("discount_amount") @db.Decimal(12, 2)
  cancellationReason String?    @map("cancellation_reason") @db.VarChar(255)
  gstRate            Decimal    @default(0) @map("gst_rate") @db.Decimal(5, 2)
  gstAmount          Decimal    @default(0) @map("gst_amount") @db.Decimal(12, 2)
  totalAmount        Decimal    @default(0) @map("total_amount") @db.Decimal(12, 2)
  status             BillStatus @default(OPEN)
  generatedAt        DateTime   @map("generated_at") @db.Timestamptz(6)
  paidAt             DateTime?  @map("paid_at") @db.Timestamptz(6)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant      Restaurant @relation(fields: [restaurantId], references: [id])
  order           Order      @relation(fields: [orderId], references: [id])
  generatedByUser User       @relation("BillGeneratedBy", fields: [generatedByUserId], references: [id])
  payments        Payment[]

  @@unique([restaurantId, billNumber]) // bill number unique per tenant
  @@index([restaurantId])
  @@index([restaurantId, status, paidAt])
  @@index([generatedByUserId])
  @@index([status])
  @@map("bills")
}

model Payment {
  tipAmount        Decimal       @default(0) @map("tip_amount") @db.Decimal(12, 2)
  id               String        @id @default(uuid()) @db.Uuid
  billId           String        @map("bill_id") @db.Uuid
  recordedByUserId String        @map("recorded_by_user_id") @db.Uuid
  paymentMethod    PaymentMethod @map("payment_method")
  amount           Decimal       @db.Decimal(12, 2)
  /// MVP permits one COMPLETED settlement per bill (enforced by a partial
  /// unique index added via raw migration — see [H6] header note). Retries may
  /// create additional PENDING/FAILED records.
  status           PaymentStatus @default(COMPLETED)
  referenceNumber  String?       @map("reference_number") @db.VarChar(255)
  paidAt           DateTime?     @map("paid_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  // Append-only: no updated_at by design.

  bill           Bill @relation(fields: [billId], references: [id], onDelete: Cascade)
  recordedByUser User @relation("PaymentRecordedBy", fields: [recordedByUserId], references: [id])

  @@index([billId])
  @@index([recordedByUserId])
  @@map("payments")
}

/// Image loaded separately so ordinary restaurant queries never select the image bytes.
model RestaurantLogo {
  restaurantId String     @id @map("restaurant_id") @db.Uuid
  mimeType     String?    @map("mime_type") @db.VarChar(20)
  data         Bytes?
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)

  @@map("restaurant_logos")
}

// ----------------------------------------------------------------------------
// QR table ordering (REST-88)
// ----------------------------------------------------------------------------

/// The restaurant's own UPI QR image, uploaded by an owner or manager. Shown to the captain when a
/// guest pays a share; payment is confirmed manually. Kept out of `restaurants` so ordinary
/// restaurant reads never load the image bytes.
model RestaurantUpiQr {
  restaurantId String   @id @map("restaurant_id") @db.Uuid
  mimeType     String   @map("mime_type") @db.VarChar(50)
  data         Bytes
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_upi_qrs")
}

/// One visit at a table, shared by every phone that scans its QR. At most one OPEN session per
/// table (partial unique index in a raw migration). Linked to the staff `orders` row once the first
/// round is approved, so billing reuses the existing order/bill model.
model QrSession {
  id              String          @id @default(uuid()) @db.Uuid
  restaurantId    String          @map("restaurant_id") @db.Uuid
  tableId         String          @map("table_id") @db.Uuid
  orderId         String?         @map("order_id") @db.Uuid
  status          QrSessionStatus @default(OPEN)
  billRequestedAt DateTime?       @map("bill_requested_at") @db.Timestamptz(6)
  splitMode       QrSplitMode?    @map("split_mode")
  closedAt        DateTime?       @map("closed_at") @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant      @relation(fields: [restaurantId], references: [id])
  table      RestaurantTable @relation(fields: [tableId], references: [id])
  order      Order?          @relation(fields: [orderId], references: [id])
  guests     QrGuest[]
  cartItems  QrCartItem[]
  rounds     QrRound[]
  shares     QrBillShare[]

  @@index([restaurantId, status])
  @@index([tableId])
  @@index([orderId])
  @@map("qr_sessions")
}

/// A phone at the table. The guest enters name and phone (both required) before ordering; the
/// phone is upserted into `guests`. The device keeps an opaque secret; only its hash is stored.
model QrGuest {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  sessionId    String   @map("session_id") @db.Uuid
  guestId      String   @map("guest_id") @db.Uuid
  displayName  String   @map("display_name") @db.VarChar(80)
  secretHash   String   @unique @map("secret_hash") @db.VarChar(64)
  lastSeenAt   DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  restaurant Restaurant    @relation(fields: [restaurantId], references: [id])
  session    QrSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  guest      Guest         @relation(fields: [guestId], references: [id])
  cartItems  QrCartItem[]
  roundItems QrRoundItem[]
  rounds     QrRound[]
  shares     QrBillShare[]

  @@index([restaurantId])
  @@index([sessionId])
  @@index([guestId])
  @@map("qr_guests")
}

/// The table's shared, not-yet-sent cart. Anyone at the table can edit or send it.
model QrCartItem {
  id                  String   @id @default(uuid()) @db.Uuid
  sessionId           String   @map("session_id") @db.Uuid
  menuItemId          String   @map("menu_item_id") @db.Uuid
  addedByGuestId      String   @map("added_by_guest_id") @db.Uuid
  quantity            Int
  specialInstructions String?  @map("special_instructions") @db.VarChar(255)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  session  QrSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  menuItem MenuItem  @relation(fields: [menuItemId], references: [id])
  addedBy  QrGuest   @relation(fields: [addedByGuestId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([menuItemId])
  @@index([addedByGuestId])
  @@map("qr_cart_items")
}

/// One sent cart. Always goes to the table's captain for approval before any KOT exists.
/// `escalateAt` is computed on submit; a DB-claimed sweep marks `escalatedAt` exactly once.
model QrRound {
  id                   String        @id @default(uuid()) @db.Uuid
  restaurantId         String        @map("restaurant_id") @db.Uuid
  sessionId            String        @map("session_id") @db.Uuid
  tableId              String        @map("table_id") @db.Uuid
  roundNumber          Int           @map("round_number")
  status               QrRoundStatus @default(AWAITING_APPROVAL)
  ownerCaptainUserId   String?       @map("owner_captain_user_id") @db.Uuid
  submittedByGuestId   String        @map("submitted_by_guest_id") @db.Uuid
  /// Client-supplied key making submit double-tap safe; unique per session.
  idempotencyKey       String        @map("idempotency_key") @db.Uuid
  note                 String?       @db.VarChar(255)
  /// Server-computed at submit from current menu prices; client totals are never trusted.
  subtotal             Decimal       @db.Decimal(12, 2)
  submittedAt          DateTime      @map("submitted_at") @db.Timestamptz(6)
  escalateAt           DateTime?     @map("escalate_at") @db.Timestamptz(6)
  escalatedAt          DateTime?     @map("escalated_at") @db.Timestamptz(6)
  onMyWayAt            DateTime?     @map("on_my_way_at") @db.Timestamptz(6)
  /// Set when the table was handed to another captain while this round waited.
  reassignedFromUserId String?       @map("reassigned_from_user_id") @db.Uuid
  reassignedAt         DateTime?     @map("reassigned_at") @db.Timestamptz(6)
  approvedAt           DateTime?     @map("approved_at") @db.Timestamptz(6)
  approvedByUserId     String?       @map("approved_by_user_id") @db.Uuid
  rejectedAt           DateTime?     @map("rejected_at") @db.Timestamptz(6)
  rejectedByUserId     String?       @map("rejected_by_user_id") @db.Uuid
  rejectReason         String?       @map("reject_reason") @db.VarChar(255)
  /// What the captain changed on approval, shown to the guest: [{ name, from, to, outOfStock }].
  editLog              Json?         @map("edit_log")
  editNote             String?       @map("edit_note") @db.VarChar(255)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant  Restaurant      @relation(fields: [restaurantId], references: [id])
  session     QrSession       @relation(fields: [sessionId], references: [id])
  table       RestaurantTable @relation(fields: [tableId], references: [id])
  owner       User?           @relation("QrRoundOwner", fields: [ownerCaptainUserId], references: [id])
  submittedBy QrGuest         @relation(fields: [submittedByGuestId], references: [id])
  approvedBy  User?           @relation("QrRoundApprovedBy", fields: [approvedByUserId], references: [id])
  rejectedBy  User?           @relation("QrRoundRejectedBy", fields: [rejectedByUserId], references: [id])
  items       QrRoundItem[]
  kots        Kot[]
  alerts      QrAlert[]

  @@unique([sessionId, roundNumber])
  @@unique([sessionId, idempotencyKey])
  @@index([restaurantId, status])
  @@index([ownerCaptainUserId, status])
  @@index([tableId])
  @@index([submittedByGuestId])
  @@index([approvedByUserId])
  @@index([rejectedByUserId])
  @@index([status, escalateAt])
  @@map("qr_rounds")
}

model QrRoundItem {
  id                  String            @id @default(uuid()) @db.Uuid
  roundId             String            @map("round_id") @db.Uuid
  menuItemId          String            @map("menu_item_id") @db.Uuid
  addedByGuestId      String            @map("added_by_guest_id") @db.Uuid
  /// Quantity the guest asked for; `quantity` is what was approved.
  requestedQuantity   Int               @map("requested_quantity")
  quantity            Int
  /// Price snapshot taken from the menu at submit time.
  unitPrice           Decimal           @map("unit_price") @db.Decimal(12, 2)
  specialInstructions String?           @map("special_instructions") @db.VarChar(255)
  status              QrRoundItemStatus @default(ACTIVE)
  /// The staff order line created on approval.
  orderItemId         String?           @map("order_item_id") @db.Uuid

  round     QrRound    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  menuItem  MenuItem   @relation(fields: [menuItemId], references: [id])
  addedBy   QrGuest    @relation(fields: [addedByGuestId], references: [id])
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id])

  @@index([roundId])
  @@index([menuItemId])
  @@index([addedByGuestId])
  @@index([orderItemId])
  @@map("qr_round_items")
}

/// One person's part of a QR session's bill. Paid only when staff record the payment (manual UPI
/// confirmation against the uploaded QR, or cash/card at the table); never from a guest's claim.
/// When paid shares cover the bill, the existing bill is settled with one COMPLETED payment.
model QrBillShare {
  id               String         @id @default(uuid()) @db.Uuid
  restaurantId     String         @map("restaurant_id") @db.Uuid
  sessionId        String         @map("session_id") @db.Uuid
  guestId          String?        @map("guest_id") @db.Uuid
  label            String         @db.VarChar(80)
  amount           Decimal        @db.Decimal(12, 2)
  /// BY_ITEM shares: [{ orderItemId, quantity }] the guest claimed.
  claimedItems     Json?          @map("claimed_items")
  status           QrShareStatus  @default(UNPAID)
  requestedMethod  PaymentMethod? @map("requested_method")
  paymentMethod    PaymentMethod? @map("payment_method")
  paidAmount       Decimal?       @map("paid_amount") @db.Decimal(12, 2)
  referenceNumber  String?        @map("reference_number") @db.VarChar(255)
  recordedByUserId String?        @map("recorded_by_user_id") @db.Uuid
  paidAt           DateTime?      @map("paid_at") @db.Timestamptz(6)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  session    QrSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  guest      QrGuest?   @relation(fields: [guestId], references: [id])
  recordedBy User?      @relation("QrShareRecordedBy", fields: [recordedByUserId], references: [id])

  @@index([restaurantId])
  @@index([sessionId])
  @@index([guestId])
  @@index([recordedByUserId])
  @@map("qr_bill_shares")
}

/// Manager alerts: a scan of a table with no captain, or an escalated round. At most one OPEN
/// no-captain alert per table and one escalation alert per round (raw partial unique indexes).
model QrAlert {
  id               String        @id @default(uuid()) @db.Uuid
  restaurantId     String        @map("restaurant_id") @db.Uuid
  tableId          String        @map("table_id") @db.Uuid
  roundId          String?       @map("round_id") @db.Uuid
  kind             QrAlertKind
  status           QrAlertStatus @default(OPEN)
  resolvedByUserId String?       @map("resolved_by_user_id") @db.Uuid
  resolution       String?       @db.VarChar(255)
  resolvedAt       DateTime?     @map("resolved_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant      @relation(fields: [restaurantId], references: [id])
  table      RestaurantTable @relation(fields: [tableId], references: [id])
  round      QrRound?        @relation(fields: [roundId], references: [id])
  resolvedBy User?           @relation("QrAlertResolvedBy", fields: [resolvedByUserId], references: [id])

  @@index([restaurantId, status, createdAt])
  @@index([tableId])
  @@index([roundId])
  @@index([resolvedByUserId])
  @@map("qr_alerts")
}

/// Web Push endpoint of a staff device (service worker + VAPID).
model PushSubscription {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  endpoint     String   @unique @db.VarChar(1000)
  p256dh       String   @db.VarChar(255)
  auth         String   @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([restaurantId, userId])
  @@map("push_subscriptions")
}

/// Append-only observations; BASELINE never claims that an earlier stage occurred at this time.
model PreparationEvent {
  id               String    @id @default(uuid()) @db.Uuid
  restaurantId     String    @map("restaurant_id") @db.Uuid
  kotId            String    @map("kot_id") @db.Uuid
  recordedByUserId String    @map("recorded_by_user_id") @db.Uuid
  action           String    @db.VarChar(20)
  status           KotStatus
  version          Int
  acceptedAt       DateTime? @map("accepted_at") @db.Timestamptz(6)
  heldAt           DateTime? @map("held_at") @db.Timestamptz(6)
  holdReason       String?   @map("hold_reason") @db.VarChar(255)
  isPriority       Boolean   @map("is_priority")
  targetSeconds    Int?      @map("target_seconds")
  reason           String?   @db.VarChar(255)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  kot        Kot        @relation(fields: [kotId], references: [id])
  recordedBy User       @relation(fields: [recordedByUserId], references: [id])

  @@unique([kotId, version])
  @@index([restaurantId, kotId, createdAt])
  @@index([recordedByUserId])
  @@map("preparation_events")
}

enum OperatingTaskKind {
  OPENING
  CLOSING
  CLEANING
  TEMPERATURE
  EXPIRY
}

enum OperatingTaskStatus {
  PENDING
  COMPLETED
  EXCEPTION
  CANCELLED
}

model OperatingTask {
  id               String              @id @default(uuid()) @db.Uuid
  restaurantId     String              @map("restaurant_id") @db.Uuid
  createdByUserId  String              @map("created_by_user_id") @db.Uuid
  assignedToUserId String              @map("assigned_to_user_id") @db.Uuid
  title            String              @db.VarChar(255)
  kind             OperatingTaskKind
  instructions     String              @db.VarChar(2000)
  dueAt            DateTime            @map("due_at") @db.Timestamptz(6)
  status           OperatingTaskStatus @default(PENDING)
  version          Int                 @default(0)
  completedAt      DateTime?           @map("completed_at") @db.Timestamptz(6)
  result           Json?
  resolution       String?             @db.VarChar(2000)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant           @relation(fields: [restaurantId], references: [id])
  createdBy  User                 @relation("TaskCreator", fields: [createdByUserId], references: [id])
  assignedTo User                 @relation("TaskAssignee", fields: [assignedToUserId], references: [id])
  events     OperatingTaskEvent[]

  @@index([restaurantId, status, dueAt])
  @@index([assignedToUserId, dueAt])
  @@index([createdByUserId])
  @@map("operating_tasks")
}

model OperatingTaskEvent {
  id               String   @id @default(uuid()) @db.Uuid
  restaurantId     String   @map("restaurant_id") @db.Uuid
  taskId           String   @map("task_id") @db.Uuid
  recordedByUserId String   @map("recorded_by_user_id") @db.Uuid
  action           String   @db.VarChar(20)
  version          Int
  snapshot         Json
  wasOverdue       Boolean  @map("was_overdue")
  reason           String?  @db.VarChar(2000)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  restaurant Restaurant    @relation(fields: [restaurantId], references: [id])
  task       OperatingTask @relation(fields: [taskId], references: [id])
  recordedBy User          @relation(fields: [recordedByUserId], references: [id])

  @@unique([taskId, version])
  @@index([restaurantId, taskId, createdAt])
  @@index([recordedByUserId])
  @@map("operating_task_events")
}

model AttendanceSession {
  id                  String    @id @default(uuid()) @db.Uuid
  restaurantId        String    @map("restaurant_id") @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  clockInAt           DateTime  @map("clock_in_at") @db.Timestamptz(6)
  clockOutAt          DateTime? @map("clock_out_at") @db.Timestamptz(6)
  version             Int       @default(0)
  appliedCorrectionId String?   @unique @map("applied_correction_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant        Restaurant             @relation(fields: [restaurantId], references: [id])
  user              User                   @relation(fields: [userId], references: [id])
  breaks            AttendanceBreak[]
  events            AttendanceEvent[]
  corrections       AttendanceCorrection[] @relation("SessionCorrections")
  appliedCorrection AttendanceCorrection?  @relation("AppliedCorrection", fields: [appliedCorrectionId], references: [id], onDelete: Restrict)

  @@index([restaurantId, userId, clockInAt])
  @@index([restaurantId, clockOutAt])
  @@map("attendance_sessions")
}

model AttendanceBreak {
  id        String    @id @default(uuid()) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  startedAt DateTime  @map("started_at") @db.Timestamptz(6)
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(6)

  session AttendanceSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId, startedAt])
  @@map("attendance_breaks")
}

model AttendanceCorrection {
  id                 String    @id @default(uuid()) @db.Uuid
  restaurantId       String    @map("restaurant_id") @db.Uuid
  sessionId          String    @map("session_id") @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  requestedByUserId  String    @map("requested_by_user_id") @db.Uuid
  reviewedByUserId   String?   @map("reviewed_by_user_id") @db.Uuid
  status             String    @default("PENDING") @db.VarChar(20)
  reason             String    @db.VarChar(2000)
  timeline           Json
  originalTimeline   Json      @map("original_timeline")
  baseSessionVersion Int       @map("base_session_version")
  version            Int       @default(0)
  reviewNote         String?   @map("review_note") @db.VarChar(2000)
  reviewedAt         DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  restaurant  Restaurant         @relation(fields: [restaurantId], references: [id])
  session     AttendanceSession  @relation("SessionCorrections", fields: [sessionId], references: [id])
  user        User               @relation("AttendanceSubject", fields: [userId], references: [id])
  requestedBy User               @relation("AttendanceRequester", fields: [requestedByUserId], references: [id])
  reviewedBy  User?              @relation("AttendanceReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  appliedTo   AttendanceSession? @relation("AppliedCorrection")
  events      AttendanceEvent[]

  @@index([restaurantId, status, createdAt])
  @@index([sessionId])
  @@index([userId])
  @@index([requestedByUserId])
  @@index([reviewedByUserId])
  @@map("attendance_corrections")
}

model AttendanceEvent {
  id               String   @id @default(uuid()) @db.Uuid
  restaurantId     String   @map("restaurant_id") @db.Uuid
  sessionId        String   @map("session_id") @db.Uuid
  recordedByUserId String   @map("recorded_by_user_id") @db.Uuid
  correctionId     String?  @map("correction_id") @db.Uuid
  action           String   @db.VarChar(30)
  deviceLabel      String?  @map("device_label") @db.VarChar(120)
  locationLabel    String?  @map("location_label") @db.VarChar(255)
  userAgent        String?  @map("user_agent") @db.VarChar(1000)
  note             String   @db.VarChar(2000)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  restaurant Restaurant            @relation(fields: [restaurantId], references: [id])
  session    AttendanceSession     @relation(fields: [sessionId], references: [id])
  recordedBy User                  @relation(fields: [recordedByUserId], references: [id])
  correction AttendanceCorrection? @relation(fields: [correctionId], references: [id], onDelete: Restrict)

  @@index([restaurantId, sessionId, createdAt])
  @@index([recordedByUserId])
  @@index([correctionId])
  @@map("attendance_events")
}

enum StaffShiftStatus {
  SCHEDULED
  CANCELLED
}

enum StaffAvailabilityKind {
  AVAILABLE
  UNAVAILABLE
}

enum StaffLeaveKind {
  ANNUAL
  SICK
  UNPAID
  OTHER
}

enum StaffLeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model StaffShift {
  id              String           @id @default(uuid()) @db.Uuid
  restaurantId    String           @map("restaurant_id") @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  createdByUserId String           @map("created_by_user_id") @db.Uuid
  startsAt        DateTime         @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime         @map("ends_at") @db.Timestamptz(6)
  note            String           @db.VarChar(1000)
  status          StaffShiftStatus @default(SCHEDULED)
  version         Int              @default(0)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  restaurant      Restaurant       @relation(fields: [restaurantId], references: [id])
  user            User             @relation("ShiftSubject", fields: [userId], references: [id])
  createdBy       User             @relation("ShiftCreator", fields: [createdByUserId], references: [id])
  events          WorkforceEvent[]

  @@index([restaurantId, userId, startsAt, endsAt])
  @@index([createdByUserId])
  @@map("staff_shifts")
}

model StaffAvailability {
  id           String                @id @default(uuid()) @db.Uuid
  restaurantId String                @map("restaurant_id") @db.Uuid
  userId       String                @map("user_id") @db.Uuid
  startsAt     DateTime              @map("starts_at") @db.Timestamptz(6)
  endsAt       DateTime              @map("ends_at") @db.Timestamptz(6)
  kind         StaffAvailabilityKind
  note         String                @db.VarChar(1000)
  isActive     Boolean               @default(true) @map("is_active")
  version      Int                   @default(0)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  restaurant   Restaurant            @relation(fields: [restaurantId], references: [id])
  user         User                  @relation(fields: [userId], references: [id])
  events       WorkforceEvent[]

  @@index([restaurantId, userId, startsAt, endsAt])
  @@map("staff_availability")
}

model StaffLeave {
  id                String           @id @default(uuid()) @db.Uuid
  restaurantId      String           @map("restaurant_id") @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  requestedByUserId String           @map("requested_by_user_id") @db.Uuid
  reviewedByUserId  String?          @map("reviewed_by_user_id") @db.Uuid
  startsAt          DateTime         @map("starts_at") @db.Timestamptz(6)
  endsAt            DateTime         @map("ends_at") @db.Timestamptz(6)
  kind              StaffLeaveKind
  reason            String           @db.VarChar(2000)
  status            StaffLeaveStatus @default(PENDING)
  reviewNote        String?          @map("review_note") @db.VarChar(2000)
  reviewedAt        DateTime?        @map("reviewed_at") @db.Timestamptz(6)
  version           Int              @default(0)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  restaurant        Restaurant       @relation(fields: [restaurantId], references: [id])
  user              User             @relation("LeaveSubject", fields: [userId], references: [id])
  requestedBy       User             @relation("LeaveRequester", fields: [requestedByUserId], references: [id])
  reviewedBy        User?            @relation("LeaveReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  events            WorkforceEvent[]

  @@index([restaurantId, userId, status, startsAt, endsAt])
  @@index([requestedByUserId])
  @@index([reviewedByUserId])
  @@map("staff_leave")
}

model WorkforceEvent {
  id               String             @id @default(uuid()) @db.Uuid
  restaurantId     String             @map("restaurant_id") @db.Uuid
  userId           String             @map("user_id") @db.Uuid
  recordedByUserId String             @map("recorded_by_user_id") @db.Uuid
  shiftId          String?            @map("shift_id") @db.Uuid
  availabilityId   String?            @map("availability_id") @db.Uuid
  leaveId          String?            @map("leave_id") @db.Uuid
  entityVersion    Int                @map("entity_version")
  action           String             @db.VarChar(20)
  snapshot         Json
  reason           String?            @db.VarChar(2000)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  restaurant       Restaurant         @relation(fields: [restaurantId], references: [id])
  user             User               @relation("WorkforceSubject", fields: [userId], references: [id])
  recordedBy       User               @relation("WorkforceRecorder", fields: [recordedByUserId], references: [id])
  shift            StaffShift?        @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  availability     StaffAvailability? @relation(fields: [availabilityId], references: [id], onDelete: Restrict)
  leave            StaffLeave?        @relation(fields: [leaveId], references: [id], onDelete: Restrict)

  @@unique([shiftId, entityVersion])
  @@unique([availabilityId, entityVersion])
  @@unique([leaveId, entityVersion])
  @@index([restaurantId, userId, createdAt])
  @@index([recordedByUserId])
  @@map("workforce_events")
}

// Batch-linked incident records preserve response history without changing inventory balances.
enum FoodIncidentStatus {
  OPEN
  RESOLVED
}

enum FoodIncidentEntryKind {
  CREATED
  NOTE
  DECISION
  CORRECTIVE_ACTION
  RESOLVED
}

model FoodIncident {
  id               String              @id @default(uuid()) @db.Uuid
  restaurantId     String              @map("restaurant_id") @db.Uuid
  title            String              @db.VarChar(150)
  description      String              @db.VarChar(4000)
  status           FoodIncidentStatus  @default(OPEN)
  version          Int                 @default(0)
  createdByUserId  String              @map("created_by_user_id") @db.Uuid
  resolvedByUserId String?             @map("resolved_by_user_id") @db.Uuid
  resolution       String?             @db.VarChar(4000)
  resolvedAt       DateTime?           @map("resolved_at") @db.Timestamptz(6)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  restaurant       Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  createdBy        User                @relation("IncidentCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  resolvedBy       User?               @relation("IncidentResolver", fields: [resolvedByUserId], references: [id], onDelete: Restrict)
  batches          FoodIncidentBatch[]
  entries          FoodIncidentEntry[]

  @@index([restaurantId, status, createdAt])
  @@index([createdByUserId])
  @@index([resolvedByUserId])
  @@map("food_incidents")
}

model FoodIncidentBatch {
  id           String       @id @default(uuid()) @db.Uuid
  restaurantId String       @map("restaurant_id") @db.Uuid
  incidentId   String       @map("incident_id") @db.Uuid
  batchId      String       @map("batch_id") @db.Uuid
  /// Immutable batch identity facts observed when the incident is recorded.
  snapshot     Json
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  incident     FoodIncident @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  batch        StockBatch   @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@unique([incidentId, batchId])
  @@index([restaurantId, batchId])
  @@index([batchId])
  @@map("food_incident_batches")
}

model FoodIncidentEntry {
  id           String                @id @default(uuid()) @db.Uuid
  restaurantId String                @map("restaurant_id") @db.Uuid
  incidentId   String                @map("incident_id") @db.Uuid
  actorId      String                @map("actor_id") @db.Uuid
  kind         FoodIncidentEntryKind
  note         String                @db.VarChar(4000)
  version      Int
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  restaurant   Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  incident     FoodIncident          @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  actor        User                  @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([incidentId, version])
  @@index([restaurantId, incidentId, createdAt])
  @@index([actorId])
  @@map("food_incident_entries")
}

model ThermalPrinter {
  restaurantId String     @map("restaurant_id") @db.Uuid
  destination  String     @db.VarChar(10)
  connection   String     @db.VarChar(10)
  networkHost  String?    @map("network_host") @db.VarChar(15)
  networkPort  Int?       @map("network_port")
  usbDevice    String?    @map("usb_device") @db.VarChar(32)
  paper        String     @db.VarChar(2)
  codePage     String     @map("code_page") @db.VarChar(8)
  columns      Int?
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)

  @@id([restaurantId, destination])
  @@map("thermal_printers")
}

model ThermalPrintConnector {
  restaurantId String     @id @map("restaurant_id") @db.Uuid
  tokenHash    String?    @unique @map("token_hash") @db.VarChar(64)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)

  @@map("thermal_print_connectors")
}
