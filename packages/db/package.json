{
  "name": "@rms/db",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma schema and client for the Restaurant Management System",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "generate": "prisma generate",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "format": "prisma format",
    "validate": "dotenv -e ../../.env -- prisma validate",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@rms/permissions": "workspace:*",
    "bcrypt": "^6.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20.16.10",
    "dotenv-cli": "^7.4.2",
    "prisma": "^5.20.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  },
  "prisma": {
    "seed": "yarn seed"
  }
}
